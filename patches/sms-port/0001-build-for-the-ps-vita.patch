+            aIn[dest] = clampv != 0;
+        }
+        s += "  }\n";
+    }
+    // the last stage's output keeps its low 8 bits, as on the console (see genFS)
+    s += strf("  TEVF4 outc = TEVF4(%s, %s);\n",
+              (cIn[lastDest] ? std::string(kRegName[lastDest]) + ".rgb" : "wrap256(" + std::string(kRegName[lastDest]) + ".rgb)").c_str(),
+              (aIn[lastA] ? std::string(kRegName[lastA]) + ".a" : "wrap256(" + std::string(kRegName[lastA]) + ".a)").c_str());
+
+    // alpha compare
+    {
+        uint32_t c0 = k.alphaFunc & 7, c1 = (k.alphaFunc >> 3) & 7, op = (k.alphaFunc >> 6) & 3;
+        auto cmp = [](uint32_t f, const char* ref) -> std::string {
+            static const char* ops[8] = {"false", "<", "==", "<=", ">", "!=", ">=", "true"};
+            if (f == 0) return "false";
+            if (f == 7) return "true";
+            return std::string("(outc.a ") + ops[f] + " " + ref + ")";
+        };
+        std::string a = cmp(c0, "u_alpharef.x"), b = cmp(c1, "u_alpharef.y");
+        std::string e;
+        switch (op) {
+        case 0: e = a + " && " + b; break;
+        case 1: e = a + " || " + b; break;
+        case 2: e = a + " != " + b; break;
+        default: e = a + " == " + b; break;
+        }
+        if (!(c0 == 7 && c1 == 7 && op <= 1) && vitaGpuTest() != 3) s += "  if (!(" + e + ")) discard;\n";
+    }
+    s += "  float4 color = float4(outc) * (1.0 / 255.0);\n";
+    if (k.fogType) {
+        s += "  float fz = v_z.x / v_z.y;\n"
+             "  float ze = u_fog.w != 0.0 ? u_fog.x * fz : u_fog.x / (u_fog.y - fz);\n"
+             "  float f = saturate(ze - u_fog.z);\n";
+        switch (k.fogType) {
+        case 4: s += "  f = 1.0 - exp2(-8.0 * f);\n"; break;
+        case 5: s += "  f = 1.0 - exp2(-8.0 * f * f);\n"; break;
+        case 6: s += "  f = exp2(-8.0 * (1.0 - f));\n"; break;
+        case 7: s += "  f = exp2(-8.0 * (1.0 - f) * (1.0 - f));\n"; break;
+        default: break;
+        }
+        s += "  color.rgb = lerp(color.rgb, u_fogcolor.rgb, f);\n";
+    }
+    // GXSetDstAlpha: the alpha written is a constant (see buildKey). The
+    // blending (gx_render.cpp) then takes the source alpha as it is; a draw
+    // that also blends colour by source alpha gets the constant there too.
+    if (k.earlyZ & 0x100) s += "  color.a = u_dstalpha;\n";
+    s += "  return color;\n}\n";
+    return s;
+}
