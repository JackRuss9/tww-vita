+static void setArrayOp(const uint8_t* p, uint32_t) {
+    struct {
+        const void* base;
+        int32_t slot;
+        uint32_t stride;
+        uint32_t be;
+    } a;
+    memcpy(&a, p, sizeof a);
+    gx::g.arrayBase[a.slot] = static_cast<const uint8_t*>(a.base);
+    gx::g.arrayStride[a.slot] = a.stride;
+    gx::g.arrayBigEndian[a.slot] = a.be != 0;
+    g_arrayGen++;
+}
+// Dual core: a matrix loaded by index (GXLoad*MtxIndx) is read from the
+// game's array when the call is made and sent as an immediate load. The
+// render thread read the array later, by which time the game could have
+// rewritten it for its next frame (frame overlap: palms, characters, shadows
+// shook). Only with frame overlap on. The arrays (12: position, 13: normal,
+// 14: texture matrices) as the game thread last set them:
+struct MtxArray {
+    const uint8_t* base;
+    uint32_t stride;
+    bool be;
+};
+static MtxArray s_mtxArr[4];
+extern "C" int GXPC_DualCore(void);  // gx_dualcore.cpp: dual core with frame overlap
+static bool loadMtxNow(int arr, uint16_t idx, uint16_t addr, uint32_t n) {
+    if (s_recording || !g_dcRec || !s_mtxArr[arr].base || !GXPC_DualCore()) return false;  // (frame overlap on)
+    const MtxArray& a = s_mtxArr[arr];
+    const uint8_t* src = a.base + size_t(idx) * a.stride;
+    uint32_t w[12];
+    for (uint32_t k = 0; k < n; k++) {
+        const uint8_t* b = src + k * 4;
+        w[k] = a.be ? uint32_t(b[0]) << 24 | uint32_t(b[1]) << 16 | uint32_t(b[2]) << 8 | b[3]
+                    : uint32_t(b[0]) | uint32_t(b[1]) << 8 | uint32_t(b[2]) << 16 | uint32_t(b[3]) << 24;
+    }
+    apiXF(addr, n, w);
+    return true;
+}
