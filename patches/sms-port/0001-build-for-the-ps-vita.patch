new file mode 100644
index 0000000..a8a0566
--- /dev/null
+++ b/platform/gx/src/gx_shader_vita.inc
@@ -0,0 +1,602 @@
+// The PS Vita's shader generator (included by gx_shader.cpp on __vita__): the
+// same XF/BP state as the GLSL one turned into Cg for vitaGL, which compiles
+// it with the Vita's own shader compiler.
+//
+// What differs from the GLSL generator:
+//   - The TEV runs in floats holding the GameCube's 0..255 integer steps:
+//     floor() where the hardware shifts, wrap256() where it keeps 8 bits, so
+//     the colours come out as the integer version's. (The Vita's GPU has no
+//     integer bit operations to speak of.)
+//   - XF memory (gx_render.cpp, flushBatch) is laid out for the Vita in
+//     float4 rows, as four uniform buffers each streamed only when it changed:
+//     xfp the position/texture matrices (64 rows), xfn the normal matrices
+//     (32 rows, xyz), xfq the post-transform matrices (64 rows) and xfl each
+//     light as 5 rows (colour as floats, cosine and distance attenuation,
+//     position, direction).
+//   - Matrix indices arrive as two attributes of 4 unsigned bytes each (the
+//     position matrix and texture matrices 0-6); texture matrix 7's is the
+//     draw's default (u_mtx7). A format without per-vertex indices takes the
+//     draw's defaults from uniforms (u_defmtx, u_mtxsel 0).
+//   - Only the vertex inputs, varyings and samplers a program uses are
+//     declared: the GPU has 16 attribute slots and the varyings cost bandwidth.
+//   - No clip distances (GX's near and far planes are the GPU's own depth
+//     clipping here) and no early depth test variant.
+//   - Fog reads the pixel's depth from a varying (zw and w, divided per pixel:
+//     the screen-linear depth, as gl_FragCoord.z gives it).
+// (kVitaXf*: gx_internal.h)
+
+namespace {
+
+struct VitaUse {
+    uint32_t coords = 0;  // texture coordinates the fragment shader reads
+    uint32_t maps = 0;    // texture maps it samples
+    bool c0 = false, c1 = false;
+};
+
+VitaUse vitaUse(const ShaderKey& k) {
+    VitaUse u;
+    if (k.depthOnly) return u;
+    for (uint32_t st = 0; st < k.numStages; st++) {
+        uint32_t ord = k.order[st];
+        uint32_t map = ord & 7, coord = (ord >> 3) & 7, en = (ord >> 6) & 1, chan = (ord >> 7) & 7;
+        if (en) {
+            u.maps |= 1u << map;
+            u.coords |= 1u << coord;
+        }
+        if (chan == 0) u.c0 = true;
+        if (chan == 1) u.c1 = true;
+    }
+    for (uint32_t i = 0; i < k.numInd; i++) {
+        u.maps |= 1u << ((k.iref >> (6 * i)) & 7);
+        u.coords |= 1u << ((k.iref >> (6 * i + 3)) & 7);
+    }
+    return u;
+}
+
+std::string strf(const char* f, ...) __attribute__((format(printf, 1, 2)));
+std::string strf(const char* f, ...) {
+    char buf[2048];
+    va_list ap;
+    va_start(ap, f);
+    vsnprintf(buf, sizeof buf, f, ap);
+    va_end(ap);
+    return buf;
+}
