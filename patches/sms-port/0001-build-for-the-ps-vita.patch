diff --git a/decomp-patches/zzzzzzzz-vita-92-thp-drawdone-dual-core.patch b/decomp-patches/zzzzzzzz-vita-92-thp-drawdone-dual-core.patch
new file mode 100644
index 0000000..430ad4a
--- /dev/null
+++ b/decomp-patches/zzzzzzzz-vita-92-thp-drawdone-dual-core.patch
@@ -0,0 +1,32 @@
+Reason: port (sms-vita): with dual core, THPPlayerDrawDone (called every frame) does not wait for the render thread (GXDrawDone); the released texture sets are reused only after the other free ones. (The file is built as C++ here: the hook is declared extern "C".)
+--- a/libs/THPPlayer/src/THPPlayer.c	2026-10-21 16:15:47.173446823 +0200
++++ b/libs/THPPlayer/src/THPPlayer.c	2026-10-21 16:30:32.770715635 +0200
+@@ -767,9 +767,28 @@
+ 	return NULL;
+ }
+ 
++#ifdef TARGET_PC
++// sms-vita dual core (sms_gx gx_dualcore.cpp): 1 while GX is drawn by the
++// render thread
++#ifdef __cplusplus
++extern "C"
++#endif
++int GXPC_DualCore(void) __attribute__((weak));
++#endif
++
+ void THPPlayerDrawDone()
+ {
++#ifdef TARGET_PC
++	// The game calls this every frame (TApplication::proc), and in Delfino
++	// Plaza the player is open for the plaza's screen. With dual core a full
++	// wait here would stop the game until the render thread drew the whole
++	// frame, every frame; the texture sets released below are only reused
++	// after the other free ones, by when the render thread has drawn them.
++	if (!(GXPC_DualCore && GXPC_DualCore()))
++		GXDrawDone();
++#else
+ 	GXDrawDone();
++#endif
+ 	if (Initialized) {
+ 		while (TRUE) {
+ 			void* tex = PopUsedTextureSet();
