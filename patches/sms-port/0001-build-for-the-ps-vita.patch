+// ------------------------------------------------------------------ DRAW THREAD
+// DRAW THREAD (sms-vita's testing menu, next start; SMS_VITA_DRAW_THREAD, with
+// GL THREAD and dual core): flushBatch's work (the shader, GL state, texture
+// binding, uniforms, the stream, the draw) runs on the GL thread, which has
+// its own copy of the GX state (g_draw = s_gb). With each batch the render
+// thread sends what changed since the last one: the BP registers, konst
+// colours and texture images (compared with what it last sent), the XF
+// registers and texcoord scale (the same), the XF memory sections written
+// (markXfMemDirty), TLUT bytes loaded, whether the state and shader
+// generations moved, and the batch itself. Copies, clears, texture
+// invalidations, pixel metrics, peeks, the HUD's layout and stage loading
+// also run there, in order (they share the texture and GL state caches).
+bool g_split = false;
+static bool s_splitTried = false;
+static State* s_gb = nullptr;    // the drawing thread's copy of the state
+static State* s_sent = nullptr;  // render thread: what it last sent
+uint32_t g_drawStateGenB = 1, g_shaderGenB = 1;  // the drawing thread's generations
+static uint32_t s_sentDrawGen = 0, s_sentShaderGen = 0;
+// render thread: XF memory written since the last send, in 16-word blocks
+static uint32_t s_fXfBlocks[(XF_MEM_WORDS / 16 + 31) / 32] = {};
+static uint32_t s_tlutLo = ~0u, s_tlutHi = 0;    // render thread: TLUT bytes loaded since
+static std::vector<uint8_t> s_rec;
+enum : uint32_t { R_BP = 1, R_XFREG = 2, R_TCM = 4, R_DRAWGEN = 8, R_SHGEN = 16, R_BATCH = 32 };
+struct RecHead {
+    uint32_t flags, bpBlocks, tlutOff, tlutLen;
+    uint32_t xfBlocks[(XF_MEM_WORDS / 16 + 31) / 32];
+    uint32_t count, fmt, stride, cls, dataBytes, idxCount, nsegs, arenaVerts, arenaIdx;
+};
+uint32_t drawGenNow() { return g_split ? g_drawStateGenB : g_drawStateGen; }
+
+void splitNoteXfRange(uint32_t addr, uint32_t count) {
+    if (!count || addr >= XF_MEM_WORDS) return;
+    uint32_t last = addr + count - 1;
+    if (last >= XF_MEM_WORDS) last = XF_MEM_WORDS - 1;
+    for (uint32_t b = addr / 16; b <= last / 16; b++) s_fXfBlocks[b >> 5] |= 1u << (b & 31);
+}
+// a whole section (markXfMemDirty's callers that name only a section)
+void splitNoteXf(uint32_t addr) {
+    const uint32_t lo = addr < 0x400 ? 0 : addr < 0x500 ? 0x400 : addr < 0x600 ? 0x500 : 0x600;
+    const uint32_t hi = addr < 0x400 ? 0x400 : addr < 0x500 ? 0x500 : addr < 0x600 ? 0x600 : XF_MEM_WORDS;
+    splitNoteXfRange(lo, hi - lo);
+}
+void splitNoteTlut(uint32_t off, uint32_t n) {
+    if (!g_split || !n) return;
+    if (off < s_tlutLo) s_tlutLo = off;
+    if (off + n > s_tlutHi) s_tlutHi = off + n;
+}
+static void recPut(const void* p, size_t n) {
+    const size_t at = s_rec.size();
+    s_rec.resize(at + ((n + 15) & ~size_t(15)));
+    if (n) memcpy(s_rec.data() + at, p, n);
+}
+// The record of what changed (and the batch); false when there is nothing.
+static bool splitWrite(bool withBatch) {
+    s_rec.clear();
+    RecHead h;
+    memset(&h, 0, sizeof h);
+    s_rec.resize((sizeof h + 15) & ~size_t(15));
+    State& f = *s_sent;
+    for (uint32_t b = 0; b < 16; b++)  // BP registers in blocks of 16
+        if (memcmp(&f.bp[b * 16], &g.bp[b * 16], 64)) {
+            h.bpBlocks |= 1u << b;
+            recPut(&g.bp[b * 16], 64);
+            memcpy(&f.bp[b * 16], &g.bp[b * 16], 64);
+        }
+    if (memcmp(f.kreg, g.kreg, sizeof g.kreg) || memcmp(f.texImage, g.texImage, sizeof g.texImage) ||
+        f.copyDest != g.copyDest) {
+        h.flags |= R_BP;
+        recPut(g.kreg, sizeof g.kreg);
+        recPut(g.texImage, sizeof g.texImage);
+        recPut(&g.copyDest, sizeof g.copyDest);
+        memcpy(f.kreg, g.kreg, sizeof g.kreg);
+        memcpy(f.texImage, g.texImage, sizeof g.texImage);
+        f.copyDest = g.copyDest;
+    }
+    if (memcmp(f.xfReg, g.xfReg, sizeof g.xfReg)) {
+        h.flags |= R_XFREG;
+        recPut(g.xfReg, sizeof g.xfReg);
+        memcpy(f.xfReg, g.xfReg, sizeof g.xfReg);
+    }
+    if (memcmp(f.tcManual, g.tcManual, sizeof g.tcManual)) {
+        h.flags |= R_TCM;
+        recPut(g.tcManual, sizeof g.tcManual);
+        memcpy(f.tcManual, g.tcManual, sizeof g.tcManual);
+    }
+    bool anyXf = false;
+    for (size_t w = 0; w < sizeof s_fXfBlocks / 4; w++) {
+        h.xfBlocks[w] = s_fXfBlocks[w];
+        for (uint32_t m = s_fXfBlocks[w]; m; m &= m - 1) {
+            const uint32_t b = uint32_t(w) * 32 + uint32_t(__builtin_ctz(m));
+            recPut(&g.xfMem[b * 16], 64);
+            anyXf = true;
+        }
+        s_fXfBlocks[w] = 0;
+    }
+    if (s_tlutHi > s_tlutLo) {
+        h.tlutOff = s_tlutLo;
+        h.tlutLen = s_tlutHi - s_tlutLo;
+        recPut(g.tlutMem + s_tlutLo, h.tlutLen);
+        s_tlutLo = ~0u;
+        s_tlutHi = 0;
+    }
+    if (g_drawStateGen != s_sentDrawGen) {
+        h.flags |= R_DRAWGEN;
+        s_sentDrawGen = g_drawStateGen;
+    }
+    if (g_shaderGen != s_sentShaderGen) {
+        h.flags |= R_SHGEN;
+        s_sentShaderGen = g_shaderGen;
+    }
+    if (withBatch) {
+        h.flags |= R_BATCH;
+        h.count = s_fb.count;
+        h.fmt = s_fb.fmt;
+        h.stride = s_fb.stride;
+        h.cls = uint32_t(s_fb.cls);
+        h.dataBytes = uint32_t(s_fb.data.size);
+        h.idxCount = uint32_t(s_fb.idx.size);
+        h.nsegs = uint32_t(s_fb.segs.size());
+        h.arenaVerts = s_fb.arenaVerts;
+        h.arenaIdx = s_fb.arenaIdx;
+        recPut(s_fb.data.data, h.dataBytes);
+        recPut(s_fb.idx.data, size_t(h.idxCount) * 4);
+        recPut(s_fb.segs.data(), h.nsegs * sizeof(BatchSeg));
+    }
+    memcpy(s_rec.data(), &h, sizeof h);
+    return h.flags || h.bpBlocks || anyXf || h.tlutLen;
+}
+// The same record written straight into the GL thread's queue (no copy
+// through s_rec, whose growth also zero-filled every byte first). The BP
+// blocks and XF registers are compared only when the state generation moved
+// since the last record: every BP/XF register write that changes a value
+// bumps it (onStateChange), but the PE token, draw done and texture
+// invalidate registers, which no draw reads (a later comparison sends them).
+// Returns false when there was nothing to send.
+struct SplitApplyFn {
+    void operator()(const uint8_t* d) const;
+};
+// LEAN DRAW RECORDS (sms-vita's testing menu, live, on): splitSend; off,
+// the records go through s_rec as before (splitWrite).
+static int s_leanRecords = 1;
+extern "C" void GXPC_SetLeanRecords(int on) { s_leanRecords = on ? 1 : 0; }
+static bool splitSend(bool withBatch) {
+    if (!s_leanRecords) {
+        if (!splitWrite(withBatch)) return false;
+        glt::postData(s_rec.data(), s_rec.size(), SplitApplyFn{});
+        return true;
+    }
+    State& f = *s_sent;
+    RecHead h;
+    memset(&h, 0, sizeof h);
+    const auto A = [](size_t n) { return (n + 15) & ~size_t(15); };
+    size_t n = A(sizeof h);
+    if (g_drawStateGen != s_sentDrawGen) {
+        for (uint32_t b = 0; b < 16; b++)
+            if (memcmp(&f.bp[b * 16], &g.bp[b * 16], 64)) {
+                h.bpBlocks |= 1u << b;
+                n += 64;
+            }
+        if (memcmp(f.xfReg, g.xfReg, sizeof g.xfReg)) {
+            h.flags |= R_XFREG;
+            n += A(sizeof g.xfReg);
+        }
+        h.flags |= R_DRAWGEN;
+    }
+    if (memcmp(f.kreg, g.kreg, sizeof g.kreg) || memcmp(f.texImage, g.texImage, sizeof g.texImage) ||
+        f.copyDest != g.copyDest) {
+        h.flags |= R_BP;
+        n += A(sizeof g.kreg) + A(sizeof g.texImage) + A(sizeof g.copyDest);
+    }
+    if (memcmp(f.tcManual, g.tcManual, sizeof g.tcManual)) {
+        h.flags |= R_TCM;
+        n += A(sizeof g.tcManual);
+    }
+    uint32_t nXf = 0;
+    for (size_t w = 0; w < sizeof s_fXfBlocks / 4; w++) {
+        h.xfBlocks[w] = s_fXfBlocks[w];
+        nXf += uint32_t(__builtin_popcount(s_fXfBlocks[w]));
+    }
+    n += size_t(nXf) * 64;
+    if (s_tlutHi > s_tlutLo) {
+        h.tlutOff = s_tlutLo;
+        h.tlutLen = s_tlutHi - s_tlutLo;
+        n += A(h.tlutLen);
+    }
+    if (g_shaderGen != s_sentShaderGen) h.flags |= R_SHGEN;
+    if (withBatch) {
+        h.flags |= R_BATCH;
+        h.count = s_fb.count;
+        h.fmt = s_fb.fmt;
+        h.stride = s_fb.stride;
+        h.cls = uint32_t(s_fb.cls);
+        h.dataBytes = uint32_t(s_fb.data.size);
+        h.idxCount = uint32_t(s_fb.idx.size);
+        h.nsegs = uint32_t(s_fb.segs.size());
+        h.arenaVerts = s_fb.arenaVerts;
+        h.arenaIdx = s_fb.arenaIdx;
+        n += A(h.dataBytes) + A(size_t(h.idxCount) * 4) + A(h.nsegs * sizeof(BatchSeg));
+    }
+    if (!h.flags && !h.bpBlocks && !nXf && !h.tlutLen) return false;
+    const size_t fnBytes = glt::align16(sizeof(SplitApplyFn));
+    if (n > glt::kMaxInline) {
+        // (too large to queue: the old way, which waits)
+        splitWrite(withBatch);
+        glt::postData(s_rec.data(), s_rec.size(), SplitApplyFn{});
+        return true;
+    }
+    uint8_t* base = static_cast<uint8_t*>(glt::reserve(&glt::dataThunk<SplitApplyFn>, fnBytes + n));
+    const SplitApplyFn fn{};
+    memcpy(base, &fn, sizeof fn);
+    uint8_t* p = base + fnBytes;
+    memcpy(p, &h, sizeof h);
+    p += A(sizeof h);
+    auto put = [&](const void* src, size_t len) {
+        if (len) memcpy(p, src, len);
+        p += A(len);
+    };
+    for (uint32_t m = h.bpBlocks; m; m &= m - 1) {
+        const uint32_t b = uint32_t(__builtin_ctz(m));
+        put(&g.bp[b * 16], 64);
+        memcpy(&f.bp[b * 16], &g.bp[b * 16], 64);
+    }
+    if (h.flags & R_BP) {
+        put(g.kreg, sizeof g.kreg);
+        put(g.texImage, sizeof g.texImage);
+        put(&g.copyDest, sizeof g.copyDest);
+        memcpy(f.kreg, g.kreg, sizeof g.kreg);
+        memcpy(f.texImage, g.texImage, sizeof g.texImage);
+        f.copyDest = g.copyDest;
+    }
+    if (h.flags & R_XFREG) {
+        put(g.xfReg, sizeof g.xfReg);
+        memcpy(f.xfReg, g.xfReg, sizeof g.xfReg);
+    }
+    if (h.flags & R_TCM) {
+        put(g.tcManual, sizeof g.tcManual);
+        memcpy(f.tcManual, g.tcManual, sizeof g.tcManual);
+    }
+    for (size_t w = 0; w < sizeof s_fXfBlocks / 4; w++) {
+        for (uint32_t m = s_fXfBlocks[w]; m; m &= m - 1) {
+            const uint32_t b = uint32_t(w) * 32 + uint32_t(__builtin_ctz(m));
+            put(&g.xfMem[b * 16], 64);
+        }
+        s_fXfBlocks[w] = 0;
+    }
+    if (h.tlutLen) {
+        put(g.tlutMem + h.tlutOff, h.tlutLen);
+        s_tlutLo = ~0u;
+        s_tlutHi = 0;
+    }
+    s_sentDrawGen = g_drawStateGen;
+    s_sentShaderGen = g_shaderGen;
+    if (withBatch) {
+        put(s_fb.data.data, h.dataBytes);
+        put(s_fb.idx.data, size_t(h.idxCount) * 4);
+        put(s_fb.segs.data(), h.nsegs * sizeof(BatchSeg));
+    }
+    glt::publish();
+    return true;
+}
+// Drawing thread: a record applied to its state, and its batch drawn.
+static void splitApply(const uint8_t* d) {
+    RecHead h;
+    memcpy(&h, d, sizeof h);
+    const uint8_t* p = d + ((sizeof h + 15) & ~size_t(15));
+    auto take = [&](void* to, size_t n) {
+        if (n) memcpy(to, p, n);
+        p += (n + 15) & ~size_t(15);
+    };
+    State& b = *s_gb;
+    for (uint32_t m = h.bpBlocks; m; m &= m - 1) take(&b.bp[__builtin_ctz(m) * 16], 64);
+    if (h.flags & R_BP) {
+        take(b.kreg, sizeof b.kreg);
+        take(b.texImage, sizeof b.texImage);
+        take(&b.copyDest, sizeof b.copyDest);
+    }
+    if (h.flags & R_XFREG) take(b.xfReg, sizeof b.xfReg);
+    if (h.flags & R_TCM) take(b.tcManual, sizeof b.tcManual);
+    for (size_t w = 0; w < sizeof h.xfBlocks / 4; w++)
+        for (uint32_t m = h.xfBlocks[w]; m; m &= m - 1) {
+            const uint32_t blk = uint32_t(w) * 32 + uint32_t(__builtin_ctz(m));
+            take(&b.xfMem[blk * 16], 64);
+            markXfMemDirtyDraw(blk * 16);  // the stream's section
+        }
+    if (h.tlutLen) take(b.tlutMem + h.tlutOff, h.tlutLen);
+    if (h.flags & R_DRAWGEN) g_drawStateGenB++;
+    if (h.flags & R_SHGEN) g_shaderGenB++;
+    if (!(h.flags & R_BATCH)) return;
+    Batch& t = s_bb;
+    t.count = h.count;
+    t.fmt = h.fmt;
+    t.stride = h.stride;
+    t.cls = PrimClass(h.cls);
+    t.data.data = const_cast<uint8_t*>(p);
+    t.data.size = h.dataBytes;
+    t.data.cap = 0;
+    p += (size_t(h.dataBytes) + 15) & ~size_t(15);
+    t.idx.data = reinterpret_cast<uint32_t*>(const_cast<uint8_t*>(p));
+    t.idx.size = h.idxCount;
+    t.idx.cap = 0;
+    p += (size_t(h.idxCount) * 4 + 15) & ~size_t(15);
+    t.segs.resize(h.nsegs);
+    if (h.nsegs) memcpy(t.segs.data(), p, h.nsegs * sizeof(BatchSeg));
+    t.arenaVerts = h.arenaVerts;
+    t.arenaIdx = h.arenaIdx;
+    flushBody();
+    t.data.data = nullptr;
+    t.idx.data = nullptr;
+    t.data.size = t.idx.size = 0;
+}
+void SplitApplyFn::operator()(const uint8_t* d) const { splitApply(d); }
+// Render thread: what changed (with no batch), before work it sends.
+void splitSync() { splitSend(false); }
+bool splitFront() { return g_split && !glt::onGlThread(); }
