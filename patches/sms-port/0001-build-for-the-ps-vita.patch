diff --git a/decomp-patches/zzzzzzzz-vita-96-mat-dl-keep.patch b/decomp-patches/zzzzzzzz-vita-96-mat-dl-keep.patch
new file mode 100644
index 0000000..0b9db32
--- /dev/null
+++ b/decomp-patches/zzzzzzzz-vita-96-mat-dl-keep.patch
@@ -0,0 +1,57 @@
+Reason: PS Vita: a J3D material's display list rebuilt the same as last frame's is drawn from the last one's buffer (its address and bytes unchanged), so the port sends it by address and needs no hash of it; the rebuilt one stays as the spare half (MAT DL REUSE, testing menu).
+--- a/libs/JSystem/src/J3D/J3DGraphBase/J3DPacket.cpp	2026-10-28 08:43:39.690686486 +0100
++++ b/libs/JSystem/src/J3D/J3DGraphBase/J3DPacket.cpp	2026-10-28 08:43:39.710794528 +0100
+@@ -10,6 +10,33 @@
+ 
+ int J3DDrawPacket::sInterruptFlag;
+ 
++#ifdef __vita__
++#include <string.h>
++// sms-vita (MAT DL REUSE in the testing menu): a material's display list is
++// rebuilt every frame into the other half of its double buffer. When the new
++// list is the same as the last one, the last one is kept (drawn from the same
++// address), and the port knows its bytes are unchanged since it sent them, so
++// they need not be copied through the command stream nor hashed again.
++// sms-port platform/gx/src/gx_api.cpp.
++extern "C" int GXPC_MatDlKeepOn(void);
++extern "C" void GXPC_DlWritten(const void* list);
++extern "C" void GXPC_DlSame(const void* list, unsigned int size);
++static u32 sSmsVitaPrevSize;  // the list's size before beginDL (begin/end never nest)
++
++static void SmsVitaKeepSameDL(J3DDisplayListObj* obj)
++{
++	void* built = obj->mpData[0];
++	void* last  = obj->mpData[1];
++	GXPC_DlWritten(built);
++	if (built == last || !GXPC_MatDlKeepOn())
++		return;
++	if (obj->mSize == sSmsVitaPrevSize && memcmp(built, last, obj->mSize) == 0) {
++		obj->swapBuffer();  // the unchanged list again
++		GXPC_DlSame(last, obj->mSize);
++	}
++}
++#endif
++
+ void J3DDisplayListObj::newDisplayList(u32 param_1)
+ {
+ 	mCapacity = ALIGN_NEXT(param_1, 0x20);
+@@ -69,6 +96,9 @@
+ 
+ void J3DDrawPacket::beginDL()
+ {
++#ifdef __vita__
++	sSmsVitaPrevSize = mpDisplayListObj->mSize;
++#endif
+ 	mpDisplayListObj->swapBuffer();
+ 	sInterruptFlag = OSDisableInterrupts();
+ 	GDInitGDLObj(&mGDList, mpDisplayListObj->mpData[0],
+@@ -83,6 +113,9 @@
+ 	mpDisplayListObj->mSize = mGDList.ptr - mGDList.start;
+ 	GDFlushCurrToMem();
+ 	GDSetCurrent(nullptr);
++#ifdef __vita__
++	SmsVitaKeepSameDL(mpDisplayListObj);
++#endif
+ 	return mpDisplayListObj->mSize;
+ }
+ 
