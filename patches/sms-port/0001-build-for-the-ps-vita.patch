+static void pktZoneLeave() {
+    if (s_pkZoneParent == -2) return;
+    if (g_zoneCur == ZONE_PKT) {  // (only when nothing left the zones unbalanced)
+        const double now = monoSeconds();
+        g_zoneSec[ZONE_PKT] += now - g_zoneSince;
+        if (g_j3dActive) g_zoneSecJ3D[ZONE_PKT] += now - g_zoneSince;
+        g_zoneN[ZONE_PKT]++;
+        if (g_j3dActive) g_zoneNJ3D[ZONE_PKT]++;
