+// (parsing, comparing, this file's work). Entered and left by hand: the
+// markers are two separate commands.
+static int s_pkZoneParent = -2;  // -2: not in the zone
+static void pktZoneEnter() {
+    if (!g_zonesOn || s_pkZoneParent != -2) return;
+    const double now = monoSeconds();
+    s_pkZoneParent = g_zoneCur;
+    if (g_zoneCur >= 0) {
+        g_zoneSec[g_zoneCur] += now - g_zoneSince;
+        if (g_j3dActive) g_zoneSecJ3D[g_zoneCur] += now - g_zoneSince;
+    }
+    g_zoneCur = ZONE_PKT;
+    g_zoneSince = now;
