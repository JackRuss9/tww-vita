+// ------------------------------------------------------------------ packet replay
+// PACKET REPLAY (sms-vita's testing menu, SMS_VITA_PKT_REPLAY; decomp patch
+// zzzzzzzz-vita-9A): J3DMatPacket::draw brackets each material packet's
+// commands with markers (GXPC_PacketBegin/End). The first time, the packet's
+// commands are recorded as they run: their bytes, the display-list entries
+// they called, and each batch they drew (arena runs only) with the BP state
+// the packet had set by then. The next time, each command is compared with
+// the recording as it arrives (an XF memory load, a matrix, may differ: it
+// is run) and the batches are drawn again at the same points from the
+// recording, with the packet's BP registers set to the values recorded.
+// Display lists are not run (state lists run only their CP and XF parts),
+// BP writes are skipped, vertex arrays and texture images are set as usual.
+// A difference, or a list whose entry or vertex arrays changed, falls back:
+// the BP state is rebuilt (the state at the packet's start, then the last
+// replayed draw's), the commands since that draw are run again as usual and
+// the packet is recorded again from there.
+bool g_pktCapturing = false;
+namespace {
+struct PktBP {
+    uint16_t idx;  // < 256 BP register, 256-263 konst colour, 264-271 texture image
+    uintptr_t v;
+};
+struct PktDraw {
+    uint32_t at;        // the command it is drawn before (its offset in the bytes)
+    uint32_t bp0, bpn;  // its BP state in Packet::bps
+    PktBatch batch;
+};
+struct PktOp {
+    uint8_t type;  // 1 CP, 2 XF registers (recorded words), 3 XF memory (from the stream), 4 indexed XF,
+                   // 5 host op (from the stream), 6 list call, 7 draw
+    uint8_t reg;
+    uint16_t a;
+    uint32_t at;  // the command's offset
+    uint32_t v, n;
+};
+struct PktDl {
+    uint32_t at;
+    DlEntry* e;
+    uint32_t version;
+};
+struct Packet {
+    bool valid = false;
+    uint32_t clearGen = 0, misses = 0, skip = 0, backoff = 0;
+    std::vector<uint8_t> bytes;
+    std::vector<PktDl> dls;
+    std::vector<PktDraw> draws;
+    std::vector<PktBP> bps;
+    uint32_t end0 = 0, endn = 0;
+    size_t mem = 0;
+    // pktCompile: the recording as a list of operations, and the parts of the
