+static void pktCaptureCmd(const uint8_t* p, uint32_t len, uint8_t op, HostOpFn fn) {
+    pktFinishCmd();
+    if (!s_pkCur) return;
+    Packet& k = *s_pkCur;
+    int kind = 3;
+    if (op == kHostOpcode) kind = pktOpKind(fn);
+    else if (op == 0x40 || (op >= 0x80 && op < 0xC0)) kind = 0;  // a raw list call, vertices of its own
+    if (!kind) {
