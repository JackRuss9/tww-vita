+        pktAbandon();
+        return;
+    }
+    d.at = s_pkCmdAt;
+    d.bp0 = uint32_t(k.bps.size());
+    pktPushState(k);
+    d.bpn = uint32_t(k.bps.size()) - d.bp0;
+    k.draws.push_back(std::move(d));
+    s_pkCmdDraws++;
