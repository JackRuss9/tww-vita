+void pktNoteBP(uint32_t reg, uint32_t data) {
+    if (!s_pkCur) return;
+    switch (reg) {
+    case BP_COPY_EXEC: case BP_PE_TOKEN_INT: case BP_PE_TOKEN: case BP_DRAWDONE: case BP_LOADTLUT1:
+    case BP_TEXINVALIDATE: case BP_COPY_DST:
+        pktAbandon();
