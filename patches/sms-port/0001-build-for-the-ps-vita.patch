+// ------------------------------------------------------------------ GX block cache
+// GX REINIT CACHE (sms-vita's testing menu, live, on; SMS_GX_MEMO=0 turns it
+// off): a block of GX calls whose only input is the API's shadow state
+// (ReInitializeGX: ~140 calls, ~30 times a frame, 80-90 us each on the Vita).
+// In dual core the block is learnt once: it runs for real, then once more on
+// a copy of the shadow state with every register word inverted (its stream
+// output thrown away). A bit of an output (a command's value, or a shadow
+// word afterwards) that is the same in both runs is a constant; one that
+// differs must be the same bit of the word it lands in, as it was before the
+// block (the API's read-modify-writes: GXSetCurrentMtx keeps MATIDX_A's
+// texture matrix indices), checked in both runs. Then each call appends the
+// recorded bytes with those bits filled in from the current state and writes
+// the shadow words the same way, instead of running the calls. Anything the
+// model cannot describe (a different stream from the two runs, a bit that
+// does not pass through) leaves the block uncached. Every 64th call runs it
+// for real and compares with the prediction: a difference turns the cache
+// off for good (logged). Not while a display list is being recorded.
+namespace {
+constexpr uint32_t kMemoA = offsetof(State, tlutMem) / 4;   // words before the TLUT memory
+constexpr uint32_t kMemoB = offsetof(State, tcManual) / 4;  // first word after it
+constexpr uint32_t kMemoEnd = sizeof(State) / 4;
+static_assert(offsetof(State, tlutMem) % 4 == 0 && offsetof(State, tcManual) % 4 == 0 && sizeof(State) % 4 == 0,
+              "State words");
+struct MemoPatch {  // a command value with bits from the state before the block
+    uint32_t off;   // in the bytes: the value's first byte
+    uint8_t size;   // 3 (BP data) or 4 (CP, XF)
+    uint32_t word, dep, cst;
+};
+struct MemoWord {  // a shadow word the block writes: (before & dep) | cst
+    uint32_t word, dep, cst;
+};
+struct Memo {
+    int state = 0;  // 0 not learnt yet, 1 learnt, 2 uncached
+    std::vector<uint8_t> bytes;
+    std::vector<MemoPatch> patches;
+    std::vector<MemoWord> words;
+    uint32_t calls = 0;
+};
+Memo s_memos[4];
+int s_memoOn = -1;
+bool s_memoBroken = false;
+uint32_t s_memoHits = 0, s_memoRecords = 0, s_memoChecks = 0;
+State* s_memoScratch = nullptr;
+
+inline uint32_t* stateWordsOf(State& s) { return reinterpret_cast<uint32_t*>(&s); }
+template <typename T> inline uint32_t wordAt(const T& field, const State& s) {
+    return uint32_t(reinterpret_cast<const uint8_t*>(&field) - reinterpret_cast<const uint8_t*>(&s)) / 4;
+}
+inline uint32_t be32(const uint8_t* p) { return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3]; }
+inline uint32_t be24(const uint8_t* p) { return uint32_t(p[0]) << 16 | uint32_t(p[1]) << 8 | p[2]; }
+
+// The words a dry run starts inverted: the register files, XF memory and the
+// fields the API sets directly (not bpMask: a one-shot the API never leaves set).
+void memoPerturbedWords(const State& S, std::vector<uint32_t>& out) {
+    auto range = [&](const void* p, size_t bytes) {
+        const uint32_t w0 = uint32_t(static_cast<const uint8_t*>(p) - reinterpret_cast<const uint8_t*>(&S)) / 4;
+        for (uint32_t k = 0; k < bytes / 4; k++) out.push_back(w0 + k);
+    };
+    range(S.bp, sizeof S.bp);
+    range(S.kreg, sizeof S.kreg);
+    range(&S.cpMatA, 4 * 4);  // cpMatA, cpMatB, cpVcdLo, cpVcdHi
+    range(S.cpVatA, sizeof S.cpVatA);
+    range(S.cpVatB, sizeof S.cpVatB);
+    range(S.cpVatC, sizeof S.cpVatC);
+    range(S.xfReg, sizeof S.xfReg);
+    range(S.xfMem, sizeof S.xfMem);
+    range(S.tcManual, sizeof S.tcManual);
+    out.push_back(wordAt(S.cullMode, S));
+    out.push_back(wordAt(S.lineWidth, S));  // with pointSize and drawSyncToken
+}
+// The shadow word a BP/CP/XF write lands in (as shadowBP/CP/XF), or ~0u.
+uint32_t memoTargetBP(const State& S, uint32_t reg, uint32_t data, bool& bad) {
+    if (reg == BP_MASK) {
+        bad = true;
+        return ~0u;
+    }
+    if (reg >= BP_TEV_REG && reg < BP_TEV_REG + 8 && (data & 0x800000)) return wordAt(S.kreg[reg & 7], S);
+    if (reg == BP_PE_TOKEN || reg == BP_PE_TOKEN_INT) bad = true;  // (writes drawSyncToken too)
+    return wordAt(S.bp[reg], S);
+}
+uint32_t memoTargetCP(const State& S, uint8_t reg) {
+    switch (reg & 0xF0) {
+    case CP_MATIDX_A: return wordAt(S.cpMatA, S);
+    case CP_MATIDX_B: return wordAt(S.cpMatB, S);
+    case CP_VCD_LO: return wordAt(S.cpVcdLo, S);
+    case CP_VCD_HI: return wordAt(S.cpVcdHi, S);
+    case CP_VAT_A: return wordAt(S.cpVatA[reg & 7], S);
+    case CP_VAT_B: return wordAt(S.cpVatB[reg & 7], S);
+    case CP_VAT_C: return wordAt(S.cpVatC[reg & 7], S);
+    default: return ~0u;
+    }
+}
+uint32_t memoTargetXF(const State& S, uint32_t addr) {
+    if (addr < XF_MEM_WORDS) return wordAt(S.xfMem[addr], S);
+    if (addr >= XF_REG_BASE && addr < XF_REG_BASE + XF_REG_COUNT) return wordAt(S.xfReg[addr - XF_REG_BASE], S);
+    return ~0u;
+}
+// One value of the stream: constant bits, and the ones that came from the
+// word it lands in, as it was before (checked in both runs).
+bool memoValue(Memo& m, uint32_t off, uint8_t size, uint32_t e1, uint32_t e2, uint32_t word, const uint32_t* pre1,
+               const uint32_t* pre2) {
+    const uint32_t d = e1 ^ e2;
+    if (!d) return true;
+    if (word == ~0u) return false;
+    const uint32_t lim = size == 3 ? 0xFFFFFFu : ~0u;
+    if ((e1 & d) != (pre1[word] & d & lim) || (e2 & d) != (pre2[word] & d & lim)) return false;
+    m.patches.push_back(MemoPatch{off, size, word, d, e1 & ~d});
+    return true;
+}
+// Compares the two runs' streams command by command; false if the model
+// cannot describe them.
+bool memoStream(Memo& m, const State& S, const std::vector<uint8_t>& b1, const std::vector<uint8_t>& b2,
+                const uint32_t* pre1, const uint32_t* pre2) {
+    if (b1.size() != b2.size()) return false;
+    size_t i = 0;
+    while (i < b1.size()) {
+        const uint8_t op = b1[i];
+        if (b2[i] != op) return false;
+        if (op == 0x61) {
+            if (i + 5 > b1.size() || b1[i + 1] != b2[i + 1]) return false;
+            bool bad = false;
+            const uint32_t e1 = be24(&b1[i + 2]), e2 = be24(&b2[i + 2]);
+            const uint32_t w1 = memoTargetBP(S, b1[i + 1], e1, bad), w2 = memoTargetBP(S, b1[i + 1], e2, bad);
+            if (bad || w1 != w2 || !memoValue(m, uint32_t(i + 2), 3, e1, e2, w1, pre1, pre2)) return false;
+            i += 5;
+        } else if (op == 0x08) {
+            if (i + 6 > b1.size() || b1[i + 1] != b2[i + 1]) return false;
+            if (!memoValue(m, uint32_t(i + 2), 4, be32(&b1[i + 2]), be32(&b2[i + 2]), memoTargetCP(S, b1[i + 1]), pre1, pre2))
+                return false;
+            i += 6;
+        } else if (op == 0x10) {
+            if (i + 5 > b1.size() || memcmp(&b1[i + 1], &b2[i + 1], 4) != 0) return false;
+            const uint32_t h = be32(&b1[i + 1]), n = (h >> 16) + 1;
+            if (i + 5 + 4 * size_t(n) > b1.size()) return false;
+            for (uint32_t k = 0; k < n; k++) {
+                const size_t at = i + 5 + 4 * k;
+                if (!memoValue(m, uint32_t(at), 4, be32(&b1[at]), be32(&b2[at]), memoTargetXF(S, (h & 0xFFFF) + k), pre1, pre2))
+                    return false;
+            }
+            i += 5 + 4 * size_t(n);
+        } else if (op == kHostOpcode) {
+            uint32_t len;
+            if (i + 1 + 4 + sizeof(HostOpFn) > b1.size()) return false;
+            memcpy(&len, &b1[i + 1], 4);
+            const size_t n = 1 + 4 + sizeof(HostOpFn) + len;
+            if (i + n > b1.size() || memcmp(&b1[i], &b2[i], n) != 0) return false;  // the same payload
+            i += n;
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+// Copies the State's words but the TLUT memory.
+void memoCopyWords(uint32_t* dst, const uint32_t* src) {
+    memcpy(dst, src, kMemoA * 4);
+    memcpy(dst + kMemoB, src + kMemoB, (kMemoEnd - kMemoB) * 4);
+}
+// Runs `body` for real and learns it (see above).
+void memoLearn(Memo& m, void (*body)(void)) {
+    static std::vector<uint32_t> pre1, post1, pre2, post2, pert;
