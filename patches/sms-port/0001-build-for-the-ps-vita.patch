diff --git a/platform/mtx/mtx_neon.inc b/platform/mtx/mtx_neon.inc
new file mode 100644
index 0000000..8d7297a
--- /dev/null
+++ b/platform/mtx/mtx_neon.inc
@@ -0,0 +1,144 @@
+// NEON versions of the hottest matrix routines for the PS Vita (included by
+// mtx.cpp into namespace mtx_neon, after <arm_neon.h>; NEON MATRICES in
+// sms-vita's testing menu, sms_mtx_neon).
+//
+// They give the same bits as mtx_host's versions on the Vita (FMA there is a
+// float multiply and a float add): every lane does the same products and sums
+// in the same order, VMLA being a multiply rounded to single and then an add.
+// The paired-single code's "+ 0 * x" and "+ 1 * x" steps (the implicit last
+// row, through Unit01) are kept as the lanes' own additions, so the signs of
+// zero results match too. What differs: NEON flushes denormals to zero (no
+// matrix the game builds holds one) and gives the default NaN.
+//
+// A 3x4 row is one quad register; a row of the product is
+// a[r][0] * b[0] + a[r][1] * b[1] + a[r][2] * b[2] + (-0, -0, 0 * q, a[r][3]),
+// q being the value the console multiplies by zero in column 2 (a[r][3] where
+// it goes through ps_madds1, a[r][2] where through ps_madd). Adding -0 leaves
+// a lane as it is.
+
+// (-0, -0, 0 * q.lane0, 1 * q.lane1), q = (q, a[r][3])
+static inline __attribute__((always_inline)) float32x4_t nLast(float32x2_t q)
+{
+	static const float kUnit01[2] = { 0.0f, 1.0f };
+	return vcombine_f32(vdup_n_f32(-0.0f), vmul_f32(vld1_f32(kUnit01), q));
+}
+
+// The row r of a * b (b's rows in B0..B2); hiQ = (q, a[r][3]).
+static inline __attribute__((always_inline)) float32x4_t nRow(float32x4_t A, float32x4_t B0, float32x4_t B1,
+                                                             float32x4_t B2, float32x2_t hiQ)
+{
+	const float32x2_t lo = vget_low_f32(A), hi = vget_high_f32(A);
+	float32x4_t r = vmulq_lane_f32(B0, lo, 0);
+	r             = vmlaq_lane_f32(r, B1, lo, 1);
+	r             = vmlaq_lane_f32(r, B2, hi, 0);
+	return vaddq_f32(r, nLast(hiQ));
+}
+
+// ps_madds1 with Unit01: column 2 adds 0 * a[r][3]
+static inline __attribute__((always_inline)) float32x2_t qS1(float32x4_t A)
+{
+	return vdup_lane_f32(vget_high_f32(A), 1); // (a3, a3)
+}
+// ps_madd with Unit01: column 2 adds 0 * a[r][2]
+static inline __attribute__((always_inline)) float32x2_t qPS(float32x4_t A)
+{
+	return vget_high_f32(A); // (a2, a3)
+}
+
+static void gMTXCopy(Mtx src, Mtx dst)
+{
+	const f32* s     = &src[0][0];
+	f32* d           = &dst[0][0];
+	float32x4_t r0 = vld1q_f32(s), r1 = vld1q_f32(s + 4), r2 = vld1q_f32(s + 8);
+	vst1q_f32(d, r0);
+	vst1q_f32(d + 4, r1);
+	vst1q_f32(d + 8, r2);
+}
+
+static void gMTXConcat(Mtx a, Mtx b, Mtx ab)
+{
+	const float32x4_t B0 = vld1q_f32(b[0]), B1 = vld1q_f32(b[1]), B2 = vld1q_f32(b[2]);
+	const float32x4_t A0 = vld1q_f32(a[0]), A1 = vld1q_f32(a[1]), A2 = vld1q_f32(a[2]);
+	const float32x4_t R0 = nRow(A0, B0, B1, B2, qS1(A0));
+	const float32x4_t R1 = nRow(A1, B0, B1, B2, qS1(A1));
+	const float32x4_t R2 = nRow(A2, B0, B1, B2, qS1(A2));
+	vst1q_f32(ab[0], R0);
+	vst1q_f32(ab[1], R1);
+	vst1q_f32(ab[2], R2);
+}
+
+// d = m * (v, 1): per row (m0 v0 + m2 v2) + (m1 v1 + m3), as ps_madd and ps_sum0.
+static inline __attribute__((always_inline)) float32x2_t nDot2(const f32* row, float32x2_t vlo, float32x2_t vhi)
+{
+	const float32x4_t M = vld1q_f32(row);
+	return vmla_f32(vmul_f32(vget_low_f32(M), vlo), vget_high_f32(M), vhi);
+}
+static void gMTXMultVec(Mtx m, Vec* src, Vec* dst)
+{
+	const float32x2_t vlo = vld1_f32(&src->x);
+	const float32x2_t vhi = vset_lane_f32(1.0f, vld1_dup_f32(&src->z), 1);
+	const float32x2_t xy  = vpadd_f32(nDot2(m[0], vlo, vhi), nDot2(m[1], vlo, vhi));
+	const float32x2_t zz  = nDot2(m[2], vlo, vhi);
+	const f32 z           = vget_lane_f32(vpadd_f32(zz, zz), 0);
+	vst1_f32(&dst->x, xy);
+	dst->z = z;
+}
+static void gJ3DPSMulMtxVec(const f32 (*mtx)[4], const f32* v, f32* d)
+{
+	const float32x2_t vlo = vld1_f32(v);
+	const float32x2_t vhi = vset_lane_f32(1.0f, vld1_dup_f32(v + 2), 1);
+	const float32x2_t xy  = vpadd_f32(nDot2(mtx[0], vlo, vhi), nDot2(mtx[1], vlo, vhi));
+	const float32x2_t zz  = nDot2(mtx[2], vlo, vhi);
+	const f32 z           = vget_lane_f32(vpadd_f32(zz, zz), 0);
+	vst1_f32(d, xy);
+	d[2] = z;
+}
+
+// dst[i] = a * b[idx[i]] (n = 0 as 1, as jsys_ps.inc). Column 2 through ps_madd.
+static void gJ3DMTXConcatArrayIndexedSrc(const f32 (*a)[4], const f32 (*b)[3][4], const u16* idx, f32 (*dst)[3][4],
+                                         u32 n)
+{
+	const float32x4_t A0 = vld1q_f32(a[0]), A1 = vld1q_f32(a[1]), A2 = vld1q_f32(a[2]);
+	if (n == 0)
+		n = 1;
+	do {
+		const f32* s         = &b[*idx++][0][0];
+		const float32x4_t B0 = vld1q_f32(s), B1 = vld1q_f32(s + 4), B2 = vld1q_f32(s + 8);
+		f32* d               = &(*dst++)[0][0];
+		vst1q_f32(d, nRow(A0, B0, B1, B2, qPS(A0)));
+		vst1q_f32(d + 4, nRow(A1, B0, B1, B2, qPS(A1)));
+		vst1q_f32(d + 8, nRow(A2, B0, B1, B2, qPS(A2)));
+	} while (--n != 0);
+}
+
+// dst[i] = a * b[i] (n = 0 as 1). Column 2 through ps_madds1, as PSMTXConcat.
+static void gJ3DPSMtxArrayConcat(const f32 (*a)[4], const f32 (*b)[4], f32 (*dst)[4], u32 n)
+{
+	const float32x4_t A0 = vld1q_f32(a[0]), A1 = vld1q_f32(a[1]), A2 = vld1q_f32(a[2]);
+	const f32* s         = &b[0][0];
+	f32* d               = &dst[0][0];
+	if (n == 0)
+		n = 1;
+	do {
+		const float32x4_t B0 = vld1q_f32(s), B1 = vld1q_f32(s + 4), B2 = vld1q_f32(s + 8);
+		s += 12;
+		const float32x4_t R0 = nRow(A0, B0, B1, B2, qS1(A0));
+		const float32x4_t R1 = nRow(A1, B0, B1, B2, qS1(A1));
+		const float32x4_t R2 = nRow(A2, B0, B1, B2, qS1(A2));
+		vst1q_f32(d, R0);
+		vst1q_f32(d + 4, R1);
+		vst1q_f32(d + 8, R2);
+		d += 12;
+	} while (--n != 0);
+}
+
+// acc += weight * (world * inv). Column 2 through ps_madd with world's row.
+static void gJ3DWeightEnvelopeMix(f32 (*acc)[4], const f32 (*world)[4], const f32 (*inv)[4], f32 weight)
+{
+	const float32x4_t I0 = vld1q_f32(inv[0]), I1 = vld1q_f32(inv[1]), I2 = vld1q_f32(inv[2]);
+	for (int r = 0; r < 3; r++) {
+		const float32x4_t W = vld1q_f32(world[r]);
+		const float32x4_t P = nRow(W, I0, I1, I2, qPS(W));
+		vst1q_f32(acc[r], vmlaq_n_f32(vld1q_f32(acc[r]), P, weight));
+	}
+}
