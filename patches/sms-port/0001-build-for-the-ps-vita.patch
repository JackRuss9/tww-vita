+Reason: PS Vita (sms-vita SMS_VITA_LTO=2 builds only, SMS_VITA_NEW_ALIGN8): the game's global operator new/new[] allocate 8-byte aligned blocks, the alignment GCC assumes for them; with link-time optimisation it merged an inlined constructor's stores into 8-byte ones and a 4-aligned block faulted. Other builds keep 4.
+--- a/libs/JSystem/src/JKernel/JKRHeap.cpp	2026-10-31 09:40:50.365115279 +0100
++++ b/libs/JSystem/src/JKernel/JKRHeap.cpp	2026-10-31 09:40:50.382400786 +0100
+@@ -252,9 +252,19 @@
+ 	JUT_ASSERT_F(false, "UNIMPLEMENTED");
+ }
+ 
++// sms-vita (SMS_VITA_LTO=2, link-time optimisation of the game's code):
++// GCC assumes the global operator new returns memory aligned for any type
++// (8 bytes on the Vita), and once constructors are inlined across files it
++// merges their stores into 8-byte ones; a JKRHeap block 4 bytes off that
++// faulted (TCardLoad's constructor). Those builds allocate 8-aligned.
++#ifdef SMS_VITA_NEW_ALIGN8
++#define SMS_VITA_NEW_ALIGN 8
++#else
++#define SMS_VITA_NEW_ALIGN 4
++#endif
+ void* operator new(size_t byteCount)
+ {
+-	return JKRHeap::alloc(byteCount, 4, nullptr);
++	return JKRHeap::alloc(byteCount, SMS_VITA_NEW_ALIGN, nullptr);
+ }
+ void* operator new(size_t byteCount, int alignment)
+ {
+@@ -267,7 +277,7 @@
+ 
+ void* operator new[](size_t byteCount)
+ {
+-	return JKRHeap::alloc(byteCount, 4, nullptr);
++	return JKRHeap::alloc(byteCount, SMS_VITA_NEW_ALIGN, nullptr);
+ }
+ void* operator new[](size_t byteCount, int alignment)
