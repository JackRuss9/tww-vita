+        const PktBP& r = k.bps[j];
+        if (r.idx < 256) {
+            if (g.bp[r.idx] != uint32_t(r.v)) {
+                g.bp[r.idx] = uint32_t(r.v);
+                changed = true;
+            }
+        } else if (r.idx < 264) {
+            if (g.kreg[r.idx - 256] != uint32_t(r.v)) {
+                g.kreg[r.idx - 256] = uint32_t(r.v);
+                changed = true;
+            }
+        } else {
+            const uint8_t* t = reinterpret_cast<const uint8_t*>(r.v);
+            if (g.texImage[r.idx - 264] != t) {
+                g.texImage[r.idx - 264] = t;
+                changed = true;
+            }
+        }
+    }
+    if (changed) {
+        g_drawStateGen++;
+        g_shaderGen++;
+    }
