+    else if (op == 0x08) zoneCount(ZONE_N_PKT_MISS_CP);
+    else if (op == 0x10 || (op >= 0x20 && op <= 0x38)) zoneCount(ZONE_N_PKT_MISS_XF);
+    else if (op == kHostOpcode && kind == 1) zoneCount(ZONE_N_PKT_MISS_LIST);
+    else zoneCount(ZONE_N_PKT_MISS_OP);
