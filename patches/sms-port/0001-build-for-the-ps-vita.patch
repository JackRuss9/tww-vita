diff --git a/decomp-patches/zzzzzzzz-vita-A1-fast-grass.patch b/decomp-patches/zzzzzzzz-vita-A1-fast-grass.patch
new file mode 100644
index 0000000..5db3a7d
--- /dev/null
+++ b/decomp-patches/zzzzzzzz-vita-A1-fast-grass.patch
@@ -0,0 +1,188 @@
+Reason: PS Vita FAST GRASS (testing menu, live, on by default): the grass is drawn from display lists built once per grass group, with the camera-facing feet and the swing in position matrices, instead of ~285,000 immediate vertices a frame (6-7 fps in grassy places).
+diff -ru a/src/MoveBG/MapObjGrass.cpp b/src/MoveBG/MapObjGrass.cpp
+--- a/src/MoveBG/MapObjGrass.cpp	2026-11-03 09:40:50.559317372 +0100
++++ b/src/MoveBG/MapObjGrass.cpp	2026-11-03 09:40:50.614130390 +0100
+@@ -28,6 +28,117 @@
+ static GXColor color_table[] __attribute__((aligned(32)))
+     = { { 0x3C, 0xC8, 0x3C, 0xFF }, { 0x28, 0x64, 0x28, 0xFF } };
+ 
++#ifdef __vita__
++// sms-vita FAST GRASS (testing menu, live; on by default): each grass group's
++// blades are built once, at load, into display lists that never change; what
++// moves every frame (the blades turned to face the camera, mDrawVec, and the
++// ten swing offsets) goes in position matrices instead. The port keeps such
++// lists decoded on the GPU, so a frame with ~95,000 blades (~285,000
++// vertices, written one by one and decoded one by one: ~60 ms of the game's
++// thread, ~150 ms of the render thread) is now ~1,000 list calls.
++// Each blade's three vertices pick their matrix: 0 the left foot (-mDrawVec),
++// 1 the right foot (+mDrawVec), 2.. the tip (its swing offset). Ten slots
++// hold two feet and eight swings, so the blades whose swing is 8 or 9 are in
++// a second list, drawn after the slots are loaded again.
++// Positions are s16 for both distances (the far blades' own format; the near
++// blades' f32 positions rounded to whole units).
++extern "C" int sms_vita_fast_grass;  // vita/src/vita_menu.cpp
++struct GrassDl {
++	u8* data;
++	u32 size;
++};
++enum { kGrassGroups = 500 };
++static GrassDl sGrassDl[kGrassGroups][2][2];  // [group][near, far][swing 0-7, 8-9]
++static bool sGrassDlOk[kGrassGroups];
++
++static inline s16 GrassRound(f32 v) { return (s16)(v < 0.0f ? v - 0.5f : v + 0.5f); }
++
++static void GrassPut16(u8*& p, s16 v)
++{
++	*p++ = (u8)((u16)v >> 8);
++	*p++ = (u8)v;
++}
++
++static bool GrassBuildDl(GrassDl& dl, const TMapObjGrassGroup* g, bool isFar, int part)
++{
++	int n = 0;
++	for (int i = 0; i < g->unk68; ++i)
++		if (((i % 10) >= 8) == (part == 1))
++			++n;
++	dl.data = nullptr;
++	dl.size = 0;
++	if (n == 0)
++		return true;
++	const int perCmd  = 21000;  // blades per GX_TRIANGLES command (65535 vertices at most)
++	const int cmds    = (n + perCmd - 1) / perCmd;
++	const u32 bytes   = (u32)cmds * 3 + (u32)n * 3 * 8;
++	const u32 size    = (bytes + 31) & ~31u;
++	u8* data          = new (0x20) u8[size];
++	if (data == nullptr)
++		return false;
++	u8* p      = data;
++	int left   = 0;
++	for (int i = 0; i < g->unk68; ++i) {
++		const int k = i % 10;
++		if ((k >= 8) != (part == 1))
++			continue;
++		if (left == 0) {
++			left = n < perCmd ? n : perCmd;
++			n -= left;
++			*p++ = GX_TRIANGLES | GX_VTXFMT0;
++			*p++ = (u8)((left * 3) >> 8);
++			*p++ = (u8)(left * 3);
++		}
++		--left;
++		const u8 tip = (u8)((2 + (part == 1 ? k - 8 : k)) * 3);
++		s16 x, z, footY, tipY;
++		if (isFar) {
++			x     = g->unk70[i].x;
++			z     = g->unk70[i].z;
++			footY = g->unk70[i].y;
++			tipY  = g->unk74[i];
++		} else {
++			x     = GrassRound(g->unk6C[i].x);
++			z     = GrassRound(g->unk6C[i].z);
++			footY = GrassRound(g->mPosition.y);
++			tipY  = GrassRound(g->unk6C[i].y);
++		}
++		// left foot, tip, right foot (drawNear/drawFar's order)
++		*p++ = 0;
++		GrassPut16(p, x);
++		GrassPut16(p, footY);
++		GrassPut16(p, z);
++		*p++ = 1;
++		*p++ = tip;
++		GrassPut16(p, x);
++		GrassPut16(p, tipY);
++		GrassPut16(p, z);
++		*p++ = 0;
++		*p++ = 3;
++		GrassPut16(p, x);
++		GrassPut16(p, footY);
++		GrassPut16(p, z);
++		*p++ = 1;
++	}
++	while (p < data + size)
++		*p++ = 0;  // GX_NOP
++	DCFlushRange(data, size);
++	dl.data = data;
++	dl.size = size;
++	return true;
++}
++
++// view * translate(tx, 0, tz)
++static void GrassLoadMtx(MtxPtr view, f32 tx, f32 tz, u32 slot)
++{
++	Mtx m;
++	MTXCopy(view, m);
++	for (int r = 0; r < 3; ++r)
++		m[r][3] = view[r][0] * tx + view[r][2] * tz + view[r][3];
++	GXLoadPosMtxImm(m, slot);
++}
++#endif
++
+ void TMapObjGrassGroup::drawNear() const
+ {
+ 	if (!shouldDrawNear())
+@@ -124,6 +235,16 @@
+ 	}
+ 
+ 	gpMapObjGrassManager->entryGrassGroup(this, unk68);
++#ifdef __vita__
++	const int index = gpMapObjGrassManager->unk10 - 1;
++	if (index >= 0 && index < kGrassGroups) {
++		bool ok = true;
++		for (int isFar = 0; isFar < 2; ++isFar)
++			for (int part = 0; part < 2; ++part)
++				ok = GrassBuildDl(sGrassDl[index][isFar][part], this, isFar != 0, part) && ok;
++		sGrassDlOk[index] = ok;
++	}
++#endif
+ }
+ 
+ TMapObjGrassGroup::TMapObjGrassGroup()
+@@ -213,6 +334,48 @@
+ void TMapObjGrassManager::draw() const
+ {
+ 	JGeometry::SMatrix34C<f32> scratch;
++#ifdef __vita__
++	bool fast = sms_vita_fast_grass && unk10 <= kGrassGroups;
++	for (int i = 0; fast && i < unk10; ++i)
++		fast = sGrassDlOk[i];
++	if (fast) {
++		initDrawNear();  // the state, and mDrawVec / mDrawVecS16 for this camera
++		GXSetVtxAttrFmt(GX_VTXFMT0, GX_VA_POS, GX_POS_XYZ, GX_S16, 0);
++		GXClearVtxDesc();
++		GXSetVtxDesc(GX_VA_PNMTXIDX, GX_DIRECT);
++		GXSetVtxDesc(GX_VA_POS, GX_DIRECT);
++		GXSetVtxDesc(GX_VA_CLR0, GX_INDEX8);
++		MtxPtr view = j3dSys.getViewMtx();
++		for (int isFar = 0; isFar < 2; ++isFar) {
++			// the feet: drawNear's float offsets, drawFar's s16 ones
++			const f32 dx = isFar ? (f32)mDrawVecS16.x : mDrawVec.x;
++			const f32 dz = isFar ? (f32)mDrawVecS16.z : mDrawVec.z;
++			for (int part = 0; part < 2; ++part) {
++				GrassLoadMtx(view, -dx, -dz, GX_PNMTX0);
++				GrassLoadMtx(view, dx, dz, GX_PNMTX1);
++				const int swings = part == 0 ? 8 : 2;
++				for (int s = 0; s < swings; ++s) {
++					const int k = part * 8 + s;
++					GrassLoadMtx(view, isFar ? (f32)unk24[k] : unk20[k], 0.0f,
++					             (u32)((2 + s) * 3));
++				}
++				for (int i = 0; i < unk10; ++i) {
++					const TMapObjGrassGroup* g = unk14[i];
++					if (isFar ? !g->shouldDrawFar() : !g->shouldDrawNear())
++						continue;
++					const GrassDl& dl = sGrassDl[i][isFar][part];
++					if (dl.data != nullptr)
++						GXCallDisplayList(dl.data, dl.size);
++				}
++			}
++		}
++		GXLoadPosMtxImm(view, GX_PNMTX0);  // what the blades were drawn with
++		GXClearVtxDesc();
++		GXSetVtxDesc(GX_VA_POS, GX_DIRECT);
++		GXSetVtxDesc(GX_VA_CLR0, GX_INDEX8);
++		return;
++	}
++#endif
+ 	initDrawNear();
+ 	for (int i = 0; i < unk10; ++i)
+ 		unk14[i]->drawNear();
