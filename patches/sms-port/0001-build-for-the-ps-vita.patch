+    s_pkCmdOpen = false;
+    Packet& k = *s_pkCur;
+    const bool drawList = s_pkCmdKind == 1 && s_dlLast && !s_dlLast->stateOnly;
+    if (s_pkCmdKind == 1) {
+        DlEntry* e = s_dlLast;
+        bool ok = e && e->valid && !e->skip;
