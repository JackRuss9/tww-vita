diff --git a/decomp-patches/zzzzzzzz-vita-98-gd-writes.patch b/decomp-patches/zzzzzzzz-vita-98-gd-writes.patch
new file mode 100644
index 0000000..12b9c13
--- /dev/null
+++ b/decomp-patches/zzzzzzzz-vita-98-gd-writes.patch
@@ -0,0 +1,53 @@
+Reason: PS Vita: GD's 16/32-bit writes read and store the list cursor once per value instead of once per byte (J3D builds every material's display list with them each frame); the bytes written are the same.
+--- a/libs/dolphin/include/dolphin/gd/GDBase.h	2026-10-28 11:04:40.461143871 +0100
++++ b/libs/dolphin/include/dolphin/gd/GDBase.h	2026-10-28 11:04:40.485987734 +0100
+@@ -61,15 +61,41 @@
+ 
+ inline static void GDWrite_s8(u8 data) { GDWrite_u8(data); }
+ 
++#ifdef __vita__
++// sms-vita: the cursor read and written once per value, not once per byte
++// (a byte store may alias __GDCurrentDL, so the compiler reloaded it each
++// time); J3D builds every material's display list this way each frame.
++inline static void GDWrite_u16(u16 data)
++{
++	GDOverflowCheck(sizeof(u16));
++	u8* p = __GDCurrentDL->ptr;
++	p[0] = (u8)(data >> 8);
++	p[1] = (u8)data;
++	__GDCurrentDL->ptr = p + 2;
++}
++#else
+ inline static void GDWrite_u16(u16 data)
+ {
+ 	GDOverflowCheck(sizeof(u16));
+ 	__GDWrite(data >> 8);
+ 	__GDWrite(data & 0xFF);
+ }
++#endif
+ 
+ inline static void GDWrite_s16(u8 data) { GDWrite_u16(data); }
+ 
++#ifdef __vita__
++inline static void GDWrite_u32(u32 data)
++{
++	GDOverflowCheck(sizeof(u32));
++	u8* p = __GDCurrentDL->ptr;
++	p[0] = (u8)(data >> 24);
++	p[1] = (u8)(data >> 16);
++	p[2] = (u8)(data >> 8);
++	p[3] = (u8)data;
++	__GDCurrentDL->ptr = p + 4;
++}
++#else
+ inline static void GDWrite_u32(u32 data)
+ {
+ 	GDOverflowCheck(sizeof(u32));
+@@ -78,6 +104,7 @@
+ 	__GDWrite((data >> 8) & 0xFF);
+ 	__GDWrite(data & 0xFF);
+ }
++#endif
+ 
+ inline static void GDWrite_s32(u8 data) { GDWrite_u32(data); }
+ 
