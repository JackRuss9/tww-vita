diff --git a/platform/os/tests/thread_switch_test.cpp b/platform/os/tests/thread_switch_test.cpp
new file mode 100644
index 0000000..6562e76
--- /dev/null
+++ b/platform/os/tests/thread_switch_test.cpp
@@ -0,0 +1,129 @@
+// OSThread scheduler stress check, for both switch methods (host threads, and
+// SMS_VITA_FIBERS=1's fibers): threads of several priorities pass messages in
+// a ring, keep values in locals and floating-point registers across every OS
+// call, exit, are joined and are made again on the same OSThread objects. Any
+// lost register, stack or wake-up shows as a wrong sum or a hang.
+#include <dolphin/os.h>
+#include <dolphin/os/OSMessage.h>
+#include <dolphin/os/OSThread.h>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <unistd.h>
+#include "os/crash.h"
+
+extern "C" void port_os_threads_init(void);
+
+extern "C" void port_log(const char* fmt, ...)
+{
+	va_list a;
+	va_start(a, fmt);
+	vfprintf(stderr, fmt, a);
+	va_end(a);
+}
+extern "C" void* port_low_alloc(unsigned long n) { return calloc(1, n); }
+extern "C" int port_vi_idle_advance(void) { return 0; }
+void port_crash_thread_init() {}
+void port_crash_emit(PortCrashLine&) {}
+bool port_crash_module(uintptr_t, uintptr_t*, const char**) { return false; }
+void port_crash_set_thread_describer(PortCrashDescriber) {}
+
+enum { kWorkers = 6, kPasses = 4000, kGenerations = 20 };
+static OSThread workers[kWorkers];
+static char stacks[kWorkers][1 << 14];
+static OSMessageQueue queues[kWorkers + 1];  // the last one is main's
+static OSMessage slots[kWorkers + 1][4];
+static OSMutex mutex;
+static long shared;  // only changed under `mutex`
+static int bad;
+
+// Deep enough to use the stack between switches.
+static long recurse(int depth, long v)
+{
+	volatile char pad[64];
+	pad[depth & 63] = (char)v;
+	if (depth == 0) {
+		OSYieldThread();
+		return v + pad[0];
+	}
+	return recurse(depth - 1, v * 3 + 1) - pad[depth & 63] + 1;
+}
+
+static void* body(void* arg)
+{
+	const int me      = (int)(intptr_t)arg;
+	OSMessageQueue* in  = &queues[me];
+	OSMessageQueue* out = &queues[me + 1];
+	double f    = 1.0 + me;  // kept in callee-saved FP registers across calls
+	double g    = 0.5;
+	long local  = me * 1000;
+	long sum    = 0;
+	for (int i = 0; i < kPasses; i++) {
+		OSMessage m;
+		OSReceiveMessage(in, &m, OS_MESSAGE_BLOCK);
+		long v = (long)(intptr_t)m;
+		sum += v;
+		f = f * 1.0000001 + g;
+		g = g * 0.999 + 0.001;
+		local += 7;
+		if ((i & 63) == 0) {
+			const long r = recurse(20, i);
+			if (r != recurse(20, i))
+				bad++;
+		}
+		OSLockMutex(&mutex);
+		const long before = shared;
+		if ((i & 15) == 0)
+			OSYieldThread();
+		shared = before + 1;
+		OSUnlockMutex(&mutex);
+		OSSendMessage(out, (OSMessage)(intptr_t)(v + 1), OS_MESSAGE_BLOCK);
+	}
+	// what the loop must have left, computed again without any OS call
+	double ef = 1.0 + me, eg = 0.5;
+	for (int i = 0; i < kPasses; i++) {
+		ef = ef * 1.0000001 + eg;
+		eg = eg * 0.999 + 0.001;
+	}
+	if (f != ef || g != eg || local != me * 1000 + 7L * kPasses)
+		bad++;
+	return (void*)(intptr_t)sum;
+}
+
+int main()
+{
+	alarm(120);
+	port_os_threads_init();
+	OSInitMutex(&mutex);
+	for (int q = 0; q <= kWorkers; q++)
+		OSInitMessageQueue(&queues[q], slots[q], 4);
+	for (int gen = 0; gen < kGenerations; gen++) {
+		for (int w = 0; w < kWorkers; w++) {
+			// priorities on both sides of main's 16
+			OSCreateThread(&workers[w], body, (void*)(intptr_t)w, stacks[w] + sizeof stacks[w],
+			               sizeof stacks[w], 10 + (w * 3 + gen) % 12, 0);
+			OSResumeThread(&workers[w]);
+		}
+		long got = 0;
+		for (int i = 0; i < kPasses; i++) {
+			OSSendMessage(&queues[0], (OSMessage)(intptr_t)i, OS_MESSAGE_BLOCK);
+			OSMessage m;
+			OSReceiveMessage(&queues[kWorkers], &m, OS_MESSAGE_BLOCK);
+			got += (long)(intptr_t)m;
+		}
+		const long want = (long)kPasses * (kPasses - 1) / 2 + (long)kWorkers * kPasses;
+		if (got != want)
+			bad++;
+		for (int w = 0; w < kWorkers; w++) {
+			void* val;
+			OSJoinThread(&workers[w], &val);
+			if ((long)(intptr_t)val != (long)kPasses * (kPasses - 1) / 2 + (long)w * kPasses)
+				bad++;
+		}
+	}
+	if (shared != (long)kWorkers * kPasses * kGenerations)
+		bad++;
+	printf("%d generations of %d threads, %d passes: %d errors\n", kGenerations, kWorkers, kPasses, bad);
+	return bad == 0 ? 0 : 1;
+}
