+                s += strf("    float3 fA = %sfloat3(A)%s, fB = %sfloat3(B)%s;\n", rnd, rndEnd, rnd, rndEnd);
+            }
+            if (bias != 3) {
+                s += strf("    TEVF ra = Da %c lerp1(Aa, Ba, Ca)%s;\n", op ? '-' : '+',
+                          bias == 1 ? " + 128.0" : bias == 2 ? " - 128.0" : "");
+                if (scale == 1) s += "    ra *= 2.0;\n";
+                else if (scale == 2) s += "    ra *= 4.0;\n";
+                else if (scale == 3) s += "    ra = floor(ra * 0.5);\n";
+            } else {
+                uint32_t mode = (scale << 1) | op;
+                const char* cond;
+                switch (mode) {
+                case 0: cond = "fA.r > fB.r"; break;
+                case 1: cond = "fA.r == fB.r"; break;
+                case 2: cond = "(fA.g * 256.0 + fA.r) > (fB.g * 256.0 + fB.r)"; break;
+                case 3: cond = "(fA.g * 256.0 + fA.r) == (fB.g * 256.0 + fB.r)"; break;
+                case 4: cond = "(fA.b * 65536.0 + fA.g * 256.0 + fA.r) > (fB.b * 65536.0 + fB.g * 256.0 + fB.r)"; break;
+                case 5: cond = "(fA.b * 65536.0 + fA.g * 256.0 + fA.r) == (fB.b * 65536.0 + fB.g * 256.0 + fB.r)"; break;
+                case 6: cond = "Aa > Ba"; break;
+                default: cond = "Aa == Ba"; break;
+                }
+                // The colour operands (A, B) are those of this stage's colour step.
+                s += strf("    float ra = Da + ((%s) ? Ca : 0.0);\n", cond);
+            }
+            s += strf("    %s.a = TEVF(clamp(ra, %s));\n", kRegName[dest], clampv ? "0.0, 255.0" : "-1024.0, 1023.0");
