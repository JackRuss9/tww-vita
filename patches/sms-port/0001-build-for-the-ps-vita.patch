+    std::vector<uint8_t> b1(GXPC_PipeBuf + len0, GXPC_PipeBuf + len1);
+    // the dry run: on a copy with the register words inverted; its stream is cut off after
+    if (!s_memoScratch) s_memoScratch = new State();
+    State& D = *s_memoScratch;
+    memoCopyWords(stateWordsOf(D), pre1.data());
+    pert.clear();
+    memoPerturbedWords(D, pert);
+    for (uint32_t w : pert) stateWordsOf(D)[w] = ~stateWordsOf(D)[w];
+    memoCopyWords(pre2.data(), stateWordsOf(D));
+    State* const api = s_apiState;
+    s_apiState = &D;
+    body();
+    s_apiState = api;
+    s_preemptPoints = preempt;
+    const uint32_t len2 = GXPC_PipeLen;
+    std::vector<uint8_t> b2;
+    if (g_dcSubmits != sub0) fatal("GX block cache: the dry run's commands were handed over");
+    if (len2 >= len1) b2.assign(GXPC_PipeBuf + len1, GXPC_PipeBuf + len2);
+    GXPC_PipeLen = len1;  // (the dry run's commands never leave)
+    memoCopyWords(post2.data(), stateWordsOf(D));
+    s_memoRecords++;
+    m.bytes.clear();
+    m.patches.clear();
+    m.words.clear();
+    m.state = 2;
+    if (len2 < len1 || !memoStream(m, S, b1, b2, pre1.data(), pre2.data())) {
+        logmsg("GX block cache: a block's stream cannot be predicted; it runs as it is");
+        return;
+    }
+    // the shadow words afterwards
+    std::vector<uint8_t> isPert(kMemoEnd, 0);
+    for (uint32_t w : pert) isPert[w] = 1;
+    for (uint32_t w = 0; w < kMemoEnd; w++) {
+        if (w == kMemoA) w = kMemoB;
+        const uint32_t a1 = pre1[w], a2 = pre2[w], p1 = post1[w], p2 = post2[w];
+        if (p1 == a1 && p2 == a2) continue;  // not written (or written with what it held, in both runs)
+        const uint32_t dep = p1 ^ p2;
+        if (!isPert[w] && dep) {
+            logmsg("GX block cache: a block's state word %u differs between the runs; it runs as it is", w);
+            return;
+        }
+        if ((p1 & dep) != (a1 & dep) || (p2 & dep) != (a2 & dep)) {
+            logmsg("GX block cache: a block's state word %u does not keep its bits; it runs as it is", w);
+            return;
+        }
+        m.words.push_back(MemoWord{w, dep, p1 & ~dep});
+    }
+    m.bytes = std::move(b1);
+    m.state = 1;
+}
+// The block's bytes and words from the current state (the words not written).
+void memoPredict(const Memo& m, uint8_t* out) {
+    const uint32_t* w = stateWordsOf(G_);
+    memcpy(out, m.bytes.data(), m.bytes.size());
+    for (const MemoPatch& p : m.patches) {
+        const uint32_t v = (w[p.word] & p.dep) | p.cst;
+        uint8_t* q = out + p.off;
+        if (p.size == 3) {
+            q[0] = uint8_t(v >> 16), q[1] = uint8_t(v >> 8), q[2] = uint8_t(v);
+        } else {
+            q[0] = uint8_t(v >> 24), q[1] = uint8_t(v >> 16), q[2] = uint8_t(v >> 8), q[3] = uint8_t(v);
+        }
+    }
+}
+}  // namespace
+
+extern "C" void GXPC_SetMemo(int on) { s_memoOn = on ? 1 : 0; }
+extern "C" void GXPC_GetMemoStats(unsigned* hits, unsigned* records, unsigned* checks, int* broken) {
+    *hits = s_memoHits;
+    *records = s_memoRecords;
+    *checks = s_memoChecks;
+    *broken = s_memoBroken ? 1 : 0;
+}
+// Runs a block of GX calls (id 0-3), or writes what it would.
+extern "C" void GXPC_MemoRun(int id, void (*body)(void)) {
+    if (s_memoOn < 0) {
+        const char* e = getenv("SMS_GX_MEMO");
+        s_memoOn = !(e && e[0] == '0');
+    }
+    if (!s_memoOn || s_memoBroken || id < 0 || id >= 4 || !g_dcRec || s_recording || !GXPC_PipeBuf ||
+        s_apiState != &s_front) {
+        body();
+        return;
+    }
+    Memo& m = s_memos[id];
+    if (m.state == 0) {
+        memoLearn(m, body);
+        maybeSubmit();
+        return;
+    }
+    if (m.state != 1) {
+        body();
+        return;
+    }
+    if (++m.calls % 64 == 0) {
+        // now and then for real, compared with the prediction
+        s_memoChecks++;
+        static std::vector<uint8_t> want;
+        static std::vector<uint32_t> wantWords;
+        want.resize(m.bytes.size());
+        memoPredict(m, want.data());
+        const uint32_t* w = stateWordsOf(G_);
+        wantWords.resize(m.words.size());
+        for (size_t k = 0; k < m.words.size(); k++) wantWords[k] = (w[m.words[k].word] & m.words[k].dep) | m.words[k].cst;
+        static std::vector<uint32_t> before;
+        before.resize(kMemoEnd);
+        memoCopyWords(before.data(), w);
+        const uint32_t len0 = GXPC_PipeLen, sub0 = g_dcSubmits;
+        const int preempt = s_preemptPoints;
+        s_preemptPoints = 0;
+        body();
+        s_preemptPoints = preempt;
+        const uint32_t len1 = GXPC_PipeLen;
+        if (g_dcSubmits != sub0 || len1 < len0) return;  // handed over meanwhile: no comparison
+        bool same = len1 - len0 == want.size() && memcmp(GXPC_PipeBuf + len0, want.data(), want.size()) == 0;
+        size_t k = 0;
+        for (uint32_t i = 0; same && i < kMemoEnd; i++) {
+            if (i == kMemoA) i = kMemoB;
+            if (k < m.words.size() && m.words[k].word == i) {
+                same = w[i] == wantWords[k];
+                k++;
+            } else {
+                same = w[i] == before[i];
+            }
+        }
+        if (!same) {
+            s_memoBroken = true;
+            logmsg("GX block cache: block %d gave other results than predicted; cache off", id);
+        }
+        maybeSubmit();
+        return;
+    }
+    const uint32_t at = GXPC_PipeLen;
+    pipeAppend(m.bytes.data(), uint32_t(m.bytes.size()));  // (room for the prediction)
+    memoPredict(m, GXPC_PipeBuf + at);
+    uint32_t* w = stateWordsOf(G_);
+    for (const MemoWord& x : m.words) w[x.word] = (w[x.word] & x.dep) | x.cst;
+    s_memoHits++;
+    maybeSubmit();
+}
+
 // GXVerify.h declares these without extern "C", so they keep C++ linkage.
 void GXSetVerifyLevel(GXWarningLevel) {}
 GXVerifyCallback GXSetVerifyCallback(GXVerifyCallback cb) { return cb; }
diff --git a/platform/gx/src/gx_dualcore.cpp b/platform/gx/src/gx_dualcore.cpp
new file mode 100644
index 0000000..6c09d7c
--- /dev/null
+++ b/platform/gx/src/gx_dualcore.cpp
@@ -0,0 +1,387 @@
+// Dual core: the game's thread records GX, a render thread runs it.
+//
+// Without it the game's thread does everything: the game, then decoding its
+// GX commands (the FIFO, display lists, vertices) and drawing them. On the
+// Vita that is one core doing ~150 ms of work a frame in Delfino while the
+// other two sit nearly idle. Here, as in Dolphin's dual-core mode, the GX API
+// only records: its register writes, the write-gather pipe's bytes and a few
+// "host operations" (pointers and data the hardware would read from memory)
+// go into the pipe's buffer, and each frame's buffer (or a large part of one)
+// is handed to a thread of its own, which parses and draws it. The game
+// carries on with the next frame meanwhile, at most one frame ahead.
+//
+// What the game's thread still needs from GX state (the SDK's read-modify-
+// write of shadowed registers, the getters) comes from a copy of the register
+// file that only the API updates (gx_api.cpp), as the SDK's own shadow state
+// on the GameCube does. Results the game reads back are handled apart: draw
+// sync tokens (and the pixel counts read in their callbacks) come back as
+// events delivered on the game's thread; EFB peeks, XFB reads and the like
+// wait for the render thread first (dcSync).
+//
+// SMS_GX_DUALCORE=0 turns it off (sms-vita: SMS_VITA_DUALCORE in env.txt).
+// Vita only; elsewhere the functions below report "off".
+#include "gx_internal.h"
+#include "gx_glthread.h"
+#include "sms_gx/gx_pc.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <atomic>
+#include <vector>
+
+#ifdef __vita__
+#include <pthread.h>
+#include <time.h>
+#include <psp2/kernel/processmgr.h>
+#include <psp2/kernel/threadmgr.h>
+#endif
+
+// sms-port platform/os (port_os_run_lower): the game's other threads run
+extern "C" void port_os_yield_wait(double seconds) __attribute__((weak));
+extern "C" void port_irq_check(void) __attribute__((weak));
+
+namespace gx {
+
+bool g_dcRec = false;  // game thread: GX is recorded for the render thread
+uint32_t g_dcSubmits = 0;
+bool g_dcOn = false;   // the render thread runs the commands
+
+#ifdef __vita__
+
+namespace {
+
+struct Chunk {
+    uint8_t* data;
+    uint32_t len, cap;
+    bool frameEnd;
+};
+
+pthread_mutex_t s_mtx = PTHREAD_MUTEX_INITIALIZER;
+pthread_cond_t s_workCv = PTHREAD_COND_INITIALIZER;  // render thread: a chunk arrived
+pthread_cond_t s_doneCv = PTHREAD_COND_INITIALIZER;  // game thread: a chunk finished
+pthread_t s_thread;
+bool s_haveThread = false;
+
+// under s_mtx
+std::vector<Chunk> s_queue;  // FIFO: front is next
+size_t s_queueHead = 0;
+std::vector<Chunk> s_free;   // buffers back from the render thread
+uint64_t s_chunksIn = 0, s_chunksDone = 0;
+uint64_t s_framesIn = 0, s_framesDone = 0;
+bool s_busy = false;  // the render thread is running a chunk
+struct Range {
+    const void* p;
+    uint32_t n;
+};
+std::vector<Range> s_invalidate;  // texture ranges the game rewrote (GXPC_InvalidateRange)
+struct SyncEvent {
+    uint16_t token;
+    uint32_t metric;
+};
+std::vector<SyncEvent> s_events;  // draw sync tokens the render thread passed
+std::atomic<uint32_t> s_eventCount{0};
+
+// statistics (GXPC_GetDualCoreTimes)
+std::atomic<uint64_t> s_busyUs{0}, s_waitUs{0}, s_bytes{0};
+std::atomic<uint32_t> s_syncs{0};
+
+uint64_t nowUs() { return sceKernelGetProcessTimeWide(); }
+
+const uint32_t kChunkBytes = 256u << 10;  // a part of a frame handed over early
+const uint32_t kInitialCap = 1u << 20;
+
+// (by the kernel's thread id: pthread_equal(pthread_self(), s_thread) never
+// matched on the Vita)
+std::atomic<int> s_renderTid{-1};
+bool onRenderThread() { return s_haveThread && sceKernelGetThreadId() == s_renderTid.load(std::memory_order_relaxed); }
+
+void applyInvalidations() {  // render thread, s_mtx held
+    for (const Range& r : s_invalidate) textureInvalidateRange(r.p, r.n);
+    s_invalidate.clear();
+}
+
+// The Vita's three cores for applications: the game's thread on the first,
+// the render thread on the other two.
+const int kCoreMask0 = 0x10000, kCoreMask1 = 0x20000, kCoreMask2 = 0x40000;
+
+void* renderMain(void*) {
+    s_renderTid.store(sceKernelGetThreadId(), std::memory_order_relaxed);
+    // cores 1 and 2: the sound mixer and the game's helper threads run there
+    // too, and the render thread should not wait behind them on one core
+    // (with the GL thread, which takes core 2: core 1 alone)
+    const char* glt = getenv("SMS_GX_GL_THREAD");
+    const bool withGl = glt && glt[0] == '1';
+    const int pin = sceKernelChangeThreadCpuAffinityMask(sceKernelGetThreadId(),
+                                                         withGl ? kCoreMask1 : kCoreMask1 | kCoreMask2);
+    logmsg("render thread started (dual core)%s", pin < 0 ? ", not pinned to cores" : withGl ? " on core 1" : " on cores 1-2");
+    pthread_mutex_lock(&s_mtx);
+    for (;;) {
+        while (s_queueHead == s_queue.size()) pthread_cond_wait(&s_workCv, &s_mtx);
+        Chunk c = s_queue[s_queueHead++];
+        if (s_queueHead == s_queue.size()) {
+            s_queue.clear();
+            s_queueHead = 0;
+        }
+        applyInvalidations();
+        s_busy = true;
+        pthread_mutex_unlock(&s_mtx);
+
+        const uint64_t t0 = nowUs();
+        runChunk(c.data, c.len);
+        s_busyUs += nowUs() - t0;
+        s_bytes += c.len;
+
+        pthread_mutex_lock(&s_mtx);
+        s_busy = false;
+        c.len = 0;
+        s_free.push_back(c);
+        s_chunksDone++;
+        if (c.frameEnd) s_framesDone++;
+        pthread_cond_broadcast(&s_doneCv);
+    }
+    return nullptr;
+}
+
+Chunk takeFree() {  // s_mtx held
+    if (!s_free.empty()) {
+        Chunk c = s_free.back();
+        s_free.pop_back();
+        return c;
+    }
+    Chunk c{static_cast<uint8_t*>(malloc(kInitialCap)), 0, kInitialCap, false};
+    if (!c.data) fatal("out of memory for a GX command buffer");
+    return c;
+}
+
+// Hands the pipe's bytes to the render thread and gives the pipe an empty
+// buffer. Game thread.
+void submit(bool frameEnd) {
+    g_dcSubmits++;
+    Chunk c;
+    c.data = pipeTake(&c.len, &c.cap);
+    c.frameEnd = frameEnd;
+    pthread_mutex_lock(&s_mtx);
+    Chunk next = takeFree();
+    if (c.len || frameEnd) {
+        s_queue.push_back(c);
+        s_chunksIn++;
+        if (frameEnd) s_framesIn++;
+        pthread_cond_signal(&s_workCv);
+    } else {
+        c.len = 0;
+        s_free.push_back(c);
+    }
+    pthread_mutex_unlock(&s_mtx);
+    pipeGive(next.data, next.cap);
+}
+
+}  // namespace
+
+bool dcOnRenderThread() { return onRenderThread(); }
+
+bool dcStart() {
+    if (g_dcOn) return true;
+    // With the GL thread on as well (SMS_VITA_GL_THREAD), the render thread's
+    // GL calls are queued for it: GX translation on one core, vitaGL on another.
+    if (glt::active()) logmsg("dual core with the GL thread: vitaGL runs on a third thread");
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 1u << 20);
+    const int err = pthread_create(&s_thread, &attr, renderMain, nullptr);
+    pthread_attr_destroy(&attr);
+    if (err != 0) {
+        logmsg("dual core off: no render thread (error %d)", err);
+        return false;
+    }
+    s_haveThread = true;
+    sceKernelChangeThreadCpuAffinityMask(sceKernelGetThreadId(), kCoreMask0);  // the game's thread
+    pipeSetDeferred(true);
+    g_dcOn = true;
+    g_dcRec = true;
+    return true;
+}
+
+void dcMaybeSubmit() {
+    if (pipeLength() >= kChunkBytes) submit(false);
+}
+
+// Waits (s_mtx held) until `done`. With the testing menu's "sound in draw
+// waits" (yield) the wait is cut in slices of a millisecond, and between them
+// the game's other threads run (port_os_yield_wait): the sound sequencer's
+// work, which otherwise interrupts the game thread later, is done while it
+// waits anyway, as on the console, where GXDrawDone sleeps the caller.
+static std::atomic<int> s_yieldInWaits{0};
+// `irqs`: without yielding, still deliver interrupts every millisecond (the
+// sound's turns: an interrupt may preempt here as on the console)
+template <typename Done> static void waitFor(Done done, bool yield, bool irqs = false) {
+    if (irqs && !yield && port_irq_check && s_yieldInWaits.load(std::memory_order_relaxed)) {
+        while (!done()) {
+            struct timespec ts;
+            clock_gettime(CLOCK_REALTIME, &ts);
+            ts.tv_nsec += 1000000;
+            if (ts.tv_nsec >= 1000000000) {
+                ts.tv_sec++;
+                ts.tv_nsec -= 1000000000;
+            }
+            pthread_cond_timedwait(&s_doneCv, &s_mtx, &ts);
+            if (done()) break;
+            pthread_mutex_unlock(&s_mtx);
+            port_irq_check();
+            pthread_mutex_lock(&s_mtx);
+        }
+        return;
+    }
+    if (!yield || !s_yieldInWaits.load(std::memory_order_relaxed) || !port_os_yield_wait) {
+        while (!done()) pthread_cond_wait(&s_doneCv, &s_mtx);
+        return;
+    }
+    while (!done()) {
+        struct timespec ts;
+        clock_gettime(CLOCK_REALTIME, &ts);
+        ts.tv_nsec += 1000000;
+        if (ts.tv_nsec >= 1000000000) {
+            ts.tv_sec++;
+            ts.tv_nsec -= 1000000000;
+        }
+        pthread_cond_timedwait(&s_doneCv, &s_mtx, &ts);
+        if (done()) break;
+        // others may record or flush (dcQueueInvalidate) meanwhile: not under s_mtx
+        pthread_mutex_unlock(&s_mtx);
+        port_os_yield_wait(0.001);
+        pthread_mutex_lock(&s_mtx);
+    }
+}
+
+void dcFrameDone() {
+    submit(true);
+    // at most one frame ahead: wait for the one before this to be drawn
+    pthread_mutex_lock(&s_mtx);
+    if (s_framesIn - s_framesDone > 1) {
+        const uint64_t t0 = nowUs();
+        // (no yield: this is inside GXCopyDisp, where the console never sleeps;
+        // but interrupts are delivered: when the GPU is the limit (100%
+        // resolution) this waits ~40 ms a frame and the sound ran dry)
+        waitFor([] { return s_framesIn - s_framesDone <= 1; }, false, true);
+        s_waitUs += nowUs() - t0;
+    }
+    pthread_mutex_unlock(&s_mtx);
+    dcDeliverDrawSyncs();
+}
+
+void dcSync(bool mayYield) {
+    if (!g_dcOn || onRenderThread()) return;
+    submit(false);
+    pthread_mutex_lock(&s_mtx);
+    const uint64_t t0 = nowUs();
+    // (everything submitted until now: what another thread records while
+    // this one yields is not waited for)
+    const uint64_t target = s_chunksIn;
+    waitFor([target] { return s_chunksDone >= target; }, mayYield);
+    if (s_chunksDone == s_chunksIn && !s_busy) applyInvalidations();  // the render thread is idle
+    s_waitUs += nowUs() - t0;
+    pthread_mutex_unlock(&s_mtx);
+    s_syncs++;
+    // (draw sync callbacks wait for the frame's end: a sync can come from
+    // places the game's callbacks should not run, a save state's picture)
+}
+
+void dcHostOp(HostOpFn fn, const void* payload, uint32_t len) {
+    uint8_t hdr[1 + 4 + sizeof(HostOpFn)];
+    hdr[0] = kHostOpcode;
+    memcpy(hdr + 1, &len, 4);
+    memcpy(hdr + 5, &fn, sizeof fn);
+    pipeAppend(hdr, sizeof hdr);
+    if (len) pipeAppend(static_cast<const uint8_t*>(payload), len);
+}
+
+void dcHostOp2(HostOpFn fn, const void* a, uint32_t na, const void* b, uint32_t nb) {
+    uint8_t hdr[1 + 4 + sizeof(HostOpFn)];
+    const uint32_t len = na + nb;
+    hdr[0] = kHostOpcode;
+    memcpy(hdr + 1, &len, 4);
+    memcpy(hdr + 5, &fn, sizeof fn);
+    pipeAppend(hdr, sizeof hdr);
+    if (na) pipeAppend(static_cast<const uint8_t*>(a), na);
+    if (nb) pipeAppend(static_cast<const uint8_t*>(b), nb);
+}
+
+void dcQueueInvalidate(const void* p, uint32_t n) {
+    pthread_mutex_lock(&s_mtx);
+    s_invalidate.push_back(Range{p, n});
+    pthread_mutex_unlock(&s_mtx);
+}
+
+void dcPushDrawSync(uint16_t token, uint32_t metric) {
+    pthread_mutex_lock(&s_mtx);
+    s_events.push_back(SyncEvent{token, metric});
+    pthread_mutex_unlock(&s_mtx);
+    s_eventCount.fetch_add(1, std::memory_order_release);
+}
+
+static uint32_t s_curMetric = 0;
+uint32_t dcCurrentMetric() { return s_curMetric; }
+
+void dcDeliverDrawSyncs() {
+    if (!s_eventCount.load(std::memory_order_acquire)) return;
+    static std::vector<SyncEvent> ev;
+    pthread_mutex_lock(&s_mtx);
+    ev.swap(s_events);
+    s_eventCount.store(0, std::memory_order_relaxed);
+    pthread_mutex_unlock(&s_mtx);
+    for (const SyncEvent& e : ev) {
+        s_curMetric = e.metric;
+        if (drawSyncCallback) drawSyncCallback(e.token);
+    }
+    ev.clear();
+}
+
+void dcGetTimes(double* busy, double* wait, double* megabytes, uint32_t* syncs) {
+    *busy = double(s_busyUs.load()) / 1e6;
+    *wait = double(s_waitUs.load()) / 1e6;
+    *megabytes = double(s_bytes.load()) / (1024.0 * 1024.0);
+    *syncs = s_syncs.load();
+}
+
+#else  // not the Vita: always off
+
+bool dcOnRenderThread() { return false; }
+bool dcStart() { return false; }
+void dcMaybeSubmit() {}
+void dcFrameDone() {}
+void dcSync(bool) {}
+void dcHostOp(HostOpFn, const void*, uint32_t) {}
+void dcHostOp2(HostOpFn, const void*, uint32_t, const void*, uint32_t) {}
+void dcQueueInvalidate(const void*, uint32_t) {}
+void dcPushDrawSync(uint16_t, uint32_t) {}
+uint32_t dcCurrentMetric() { return 0; }
+void dcDeliverDrawSyncs() {}
+void dcGetTimes(double* busy, double* wait, double* megabytes, uint32_t* syncs) {
+    *busy = *wait = *megabytes = 0;
+    *syncs = 0;
+}
+
+#endif
+
+}  // namespace gx
+
+extern "C" void GXPC_Sync(void) { gx::dcSync(); }
+// Frame overlap (sms-vita's menu): THPPlayerDrawDone, at the end of every
+// frame, skips its wait for the render thread (decomp-patches
+// zzzzzzzz-vita-92), so the game computes its next frame while this one is
+// drawn. Faster where the drawing is the limit. What the game rewrites every
+// frame in place could then be drawn with the next frame's values (a shake):
+// matrices loaded by index are read on the game thread meanwhile
+// (gx_api.cpp loadMtxNow). On by default in sms-vita.
+static std::atomic<int> s_overlap{0};
+#ifdef __vita__
+extern "C" void GXPC_SetYieldInWaits(int on) { gx::s_yieldInWaits.store(on ? 1 : 0); }
+#else
+extern "C" void GXPC_SetYieldInWaits(int) {}
+#endif
+extern "C" void GXPC_SetFrameOverlap(int on) { s_overlap.store(on ? 1 : 0); }
