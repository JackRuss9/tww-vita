+// ------------------------------------------------------------------ vertex shader
+static void emitLightVita(std::string& s, uint32_t ctrl, const char* comp, int light) {
+    const int L = light * 5;  // xfl: colour, A, K, position, direction
+    uint32_t diff = (ctrl >> 7) & 3;
+    bool attn = (ctrl >> 9) & 1, spot = (ctrl >> 10) & 1;
+    const char* dfn = diff == 0 ? "1.0" : diff == 1 ? "dot(N, Ld)" : "max(dot(N, Ld), 0.0)";
+    if (!attn) {
+        s += strf("    { float3 Ld = normalize(xfl[%d].xyz - vpos); lsum%s += (%s) * xfl[%d]%s; }\n", L + 3, comp, dfn, L,
+                  comp);
+    } else if (spot) {
+        s += strf("    { float3 Ld = xfl[%d].xyz - vpos; float d2 = dot(Ld, Ld); float d = sqrt(d2); Ld /= d;\n"
+                  "      float cs = max(dot(Ld, xfl[%d].xyz), 0.0); float3 a = xfl[%d].xyz; float3 kk = xfl[%d].xyz;\n"
+                  "      float at = max(a.x + a.y * cs + a.z * cs * cs, 0.0) / max(kk.x + kk.y * d + kk.z * d2, 1e-30);\n"
+                  "      lsum%s += at * (%s) * xfl[%d]%s; }\n",
+                  L + 3, L + 4, L + 1, L + 2, comp, dfn, L, comp);
+    } else {
+        s += strf("    { float3 Ld = normalize(xfl[%d].xyz); float nl = dot(N, Ld);\n"
+                  "      float t = nl > 0.0 ? max(dot(N, xfl[%d].xyz), 0.0) : 0.0; float3 a = xfl[%d].xyz; float3 kk = xfl[%d].xyz;\n"
+                  "      float at = max(a.x + a.y * t + a.z * t * t, 0.0) / max(kk.x + kk.y * t + kk.z * t * t, 1e-30);\n"
+                  "      lsum%s += at * (%s) * xfl[%d]%s; }\n",
+                  L + 3, L + 4, L + 1, L + 2, comp, dfn, L, comp);
+    }
+}
+
+static std::string genVS(const ShaderKey& k) {
+    const VitaUse use = vitaUse(k);
+    // the colour channels the code below needs: for the fragment shader, or
+    // for a texgen from a channel's colour
+    bool needCol[2] = {use.c0, use.c1};
+    for (uint32_t i = 0; i < k.numTexGens; i++) {
+        uint32_t type = (k.texgen[i] >> 4) & 7;
+        if (type == 2) needCol[0] = true;
+        if (type == 3) needCol[1] = true;
+    }
+    // which vertex inputs it reads
+    bool nrm = false, bin = false, tan = false, clr[2] = {false, false}, mtx1 = false;
+    uint32_t tex = 0;
+    for (int c = 0; c < 2; c++) {
+        if (uint32_t(c) >= k.numChans || !needCol[c]) continue;
+        for (int part = 0; part < 2; part++) {
+            uint32_t ctrl = k.chan[c + 2 * part];
+            if (ctrl & 1) clr[c] = true;
+            if (ctrl & 2) {
+                if (ctrl & 64) clr[c] = true;
+                if ((((ctrl >> 2) & 15) | ((ctrl >> 11) & 15) << 4) != 0) nrm = true;
+            }
+        }
+    }
+    for (uint32_t i = 0; i < 8; i++) {
+        if (i >= k.numTexGens) {
+            if (use.coords & (1u << i)) tex |= 1u << i;
+            continue;
+        }
+        uint32_t tg = k.texgen[i], type = (tg >> 4) & 7, row = (tg >> 7) & 31;
+        if (type == 0 || type == 1) {
+            if (row == 1) nrm = true;
+            else if (row == 2) clr[0] = true;
+            else if (row == 3) bin = true;
+            else if (row == 4) tan = true;
+            else if (row >= 5) tex |= 1u << ((row - 5) & 7);
+            if (type == 0 && i >= 3 && i <= 6) mtx1 = true;
+        }
+    }
+
+    std::string s;
+    // XF memory as arrays in buffers 0-3 (the compiler takes no GLSL-style
+    // block; vitaGL binds BUFFER[n] to binding n: vita/vitagl-patches/0003)
+    s += strf("uniform float4 xfp[%d] : BUFFER[0];\nuniform float4 xfn[%d] : BUFFER[1];\n"
+              "uniform float4 xfq[%d] : BUFFER[2];\nuniform float4 xfl[%d] : BUFFER[3];\n",
+              int(kVitaXfPosRows), int(kVitaXfNrmRows), int(kVitaXfPostRows), int(kVitaXfLightRows));
+    s += "uniform float4 u_proj[2];\nuniform float4 u_vp[2];\nuniform float2 u_efb;\nuniform float4 u_chan[4];\n"
+         "uniform float u_mtx7;\nuniform float4 u_defmtx[2];\nuniform float u_mtxsel;\n";
+    s += "void main(float3 a_pos";
+    if (nrm) s += ", float3 a_nrm";
+    if (bin) s += ", float3 a_bin";
+    if (tan) s += ", float3 a_tan";
+    if (clr[0]) s += ", float4 a_clr0";
+    if (clr[1]) s += ", float4 a_clr1";
+    for (int t = 0; t < 8; t++)
+        if (tex & (1u << t)) s += strf(", float2 a_tex%d", t);
+    s += ", float4 a_mtx0";
+    if (mtx1) s += ", float4 a_mtx1";
+    s += ",\n  out float4 gl_Position : POSITION";
+    if (use.c0) s += ", out float4 v_c0 : COLOR0";
+    if (use.c1) s += ", out float4 v_c1 : COLOR1";
+    for (int t = 0; t < 8; t++)
+        // four components: with three, the fragment shader's z (a projected
+        // coordinate's divisor) did not arrive (the airport's heat haze)
+        if (use.coords & (1u << t)) s += strf(", out float4 v_tc%d : TEXCOORD%d", t, t);
+    if (k.fogType) s += ", out float2 v_z : TEXCOORD8";
+    s += ") {\n";
+    // The indices come per vertex (u_mtxsel 1) or are the draw's defaults:
+    // uniforms, which each draw keeps (a constant attribute is read when the
+    // GPU draws, so every draw would see the last one set).
+    s += "  float4 m0 = u_mtxsel != 0.0 ? floor(a_mtx0 * 255.0 + 0.5) : u_defmtx[0];\n";
+    if (mtx1) s += "  float4 m1 = u_mtxsel != 0.0 ? floor(a_mtx1 * 255.0 + 0.5) : u_defmtx[1];\n";
+    // int() on the Vita rounds to the nearest integer (halves to even), so
+    // int(x + 0.5) read the next row: the index is floored first.
+    s += "  int pm = int(floor(m0.x + 0.5));\n"
+         "  float4 p = float4(a_pos, 1.0);\n"
+         "  float3 vpos = float3(dot(xfp[pm], p), dot(xfp[pm + 1], p), dot(xfp[pm + 2], p));\n";
+    if (nrm) {
+        s += "  float3 N = float3(dot(xfn[pm].xyz, a_nrm), dot(xfn[pm + 1].xyz, a_nrm), dot(xfn[pm + 2].xyz, a_nrm));\n"
+             "  N = dot(N, N) > 0.0 ? normalize(N) : float3(0.0, 0.0, 1.0);\n";
+    }
+    s += "  float4 clp;\n"
+         "  if (u_proj[1].z == 0.0) {\n"
+         "    clp = float4(u_proj[0].x * vpos.x + u_proj[0].y * vpos.z, u_proj[0].z * vpos.y + u_proj[0].w * vpos.z,\n"
+         "                  u_proj[1].x * vpos.z + u_proj[1].y, -vpos.z);\n"
+         "  } else {\n"
+         "    clp = float4(u_proj[0].x * vpos.x + u_proj[0].y, u_proj[0].z * vpos.y + u_proj[0].w,\n"
+         "                  u_proj[1].x * vpos.z + u_proj[1].y, 1.0);\n"
+         "  }\n"
+         "  float zw = u_vp[1].z * clp.w + u_vp[0].z * clp.z;\n"
+         "  gl_Position = float4(((u_vp[1].x - 342.0) * clp.w + u_vp[0].x * clp.x) * (2.0 / u_efb.x) - clp.w,\n"
+         "                       ((u_vp[1].y - 342.0) * clp.w + u_vp[0].y * clp.y) * (2.0 / u_efb.y) - clp.w,\n"
+         "                       zw * (2.0 / 16777215.0) - clp.w, clp.w);\n";
+    if (k.fogType) s += "  v_z = float2(zw * (1.0 / 16777215.0), clp.w);\n";
+
+    // lighting: channels 0/1, colour and alpha controlled separately
+    const char* vtx[2] = {"a_clr0", "a_clr1"};
+    for (int c = 0; c < 2; c++) {
+        if (!needCol[c]) continue;
+        s += strf("  float4 col%d = float4(0.0, 0.0, 0.0, 0.0);\n", c);
+        if (uint32_t(c) >= k.numChans) continue;
+        for (int part = 0; part < 2; part++) {
+            uint32_t ctrl = k.chan[c + 2 * part];
+            const char* comp = part ? ".a" : ".rgb";
+            s += strf("  { float4 mat = %s;\n", (ctrl & 1) ? vtx[c] : (c ? "u_chan[3]" : "u_chan[2]"));
+            if (ctrl & 2) {
+                s += strf("    float4 lsum = %s;\n", (ctrl & 64) ? vtx[c] : (c ? "u_chan[1]" : "u_chan[0]"));
+                uint32_t mask = ((ctrl >> 2) & 15) | ((ctrl >> 11) & 15) << 4;
+                for (int l = 0; l < 8; l++)
+                    if (mask & (1u << l)) emitLightVita(s, ctrl, comp, l);
+                s += strf("    col%d%s = (mat * saturate(lsum))%s; }\n", c, comp, comp);
+            } else {
+                s += strf("    col%d%s = mat%s; }\n", c, comp, comp);
+            }
+        }
+    }
+    if (use.c0) s += "  v_c0 = col0;\n";
+    if (use.c1) s += "  v_c1 = col1;\n";
+
+    // texgen (each kept in t<i> for an emboss texgen reading an earlier one)
+    for (uint32_t i = 0; i < 8; i++) {
+        const bool out = (use.coords >> i) & 1;
+        if (i >= k.numTexGens) {
+            if (out) s += strf("  v_tc%u = float4(a_tex%u, 1.0, 1.0);\n", i, i);
+            continue;
+        }
+        uint32_t tg = k.texgen[i];
+        uint32_t proj = (tg >> 1) & 1, form = (tg >> 2) & 1, type = (tg >> 4) & 7, row = (tg >> 7) & 31;
+        uint32_t embSrc = (tg >> 12) & 7;
+        std::string src;
+        if (row == 0) src = "float4(a_pos, 1.0)";
+        else if (row == 1) src = "float4(a_nrm, 1.0)";
+        else if (row == 2) src = "a_clr0";
+        else if (row == 3) src = "float4(a_bin, 1.0)";
+        else if (row == 4) src = "float4(a_tan, 1.0)";
+        else src = strf("float4(a_tex%u, 1.0, 1.0)", (row - 5) & 7);
+        if (form == 0 && row < 5) src = "float4((" + src + ").xy, 1.0, 1.0)";
+        // texture matrix row for this coordinate
+        static const char* const mi[8] = {"m0.y", "m0.z", "m0.w", "m1.x", "m1.y", "m1.z", "m1.w", "u_mtx7"};
+        if (type == 0) {
+            s += strf("  float3 t%u;\n  { float4 sv = %s; int tm = int(floor(%s + 0.5));\n"
+                      "    t%u = float3(dot(xfp[tm], sv), dot(xfp[tm + 1], sv), %s);\n",
+                      i, src.c_str(), mi[i], i, proj ? "dot(xfp[tm + 2], sv)" : "1.0");
+        } else if (type == 1) {
+            // emboss: offset of the source coordinate (approximated as the source itself)
+            s += strf("  float3 t%u;\n  { t%u = t%u;\n", i, i, embSrc < i ? embSrc : 0u);
+        } else {
+            s += strf("  float3 t%u;\n  { t%u = float3(%s.rg, 1.0);\n", i, i, type == 3 ? "col1" : "col0");
+        }
+        if (k.dualTex && type == 0) {
+            uint32_t pt = k.post[i] & 63;
+            bool norm = (k.post[i] >> 8) & 1;
+            s += strf("    %s float4 pv = float4(t%u, 1.0);\n"
+                      "    t%u = float3(dot(xfq[%u], pv), dot(xfq[%u], pv), dot(xfq[%u], pv));\n",
+                      norm ? strf("t%u = normalize(t%u);", i, i).c_str() : "", i, i, pt, pt + 1, pt + 2);
+        }
+        s += "  }\n";
+        if (out) s += strf("  v_tc%u = float4(t%u, 1.0);\n", i, i);
+    }
+    s += "}\n";
+    return s;
+}
+
+// ------------------------------------------------------------------ fragment shader
+// Colours are floats in 0..255 steps; see the header comment. TEVF, TEVF3 and
+// TEVF4 are the TEV's types: float, or half with SMS_VITA_FAST_SHADING=2.
+static const char* kVitaFsTypesFloat = "#define TEVF float\n#define TEVF3 float3\n#define TEVF4 float4\n";
+static const char* kVitaFsTypesHalf = "#define TEVF half\n#define TEVF3 half3\n#define TEVF4 half4\n";
+static const char* kVitaFsHelpers =
+    "TEVF3 wrap256(TEVF3 v) { return v - 256.0 * floor(v * (1.0 / 256.0)); }\n"
+    "TEVF wrap256(TEVF v) { return v - 256.0 * floor(v * (1.0 / 256.0)); }\n"
+    "TEVF4 texi(float4 c) { return TEVF4(floor(saturate(c) * 255.0 + 0.5)); }\n"
+    "float2 projc(float4 t) { return t.xy / (t.z == 0.0 ? 1.0 : t.z); }\n"
+    "TEVF3 lerp3(TEVF3 a, TEVF3 b, TEVF3 c) { TEVF3 c2 = c + floor(c * (1.0 / 128.0));\n"
+    "  return floor((a * (256.0 - c2) + b * c2 + 128.0) * (1.0 / 256.0)); }\n"
+    "TEVF lerp1(TEVF a, TEVF b, TEVF c) { TEVF c2 = c + floor(c * (1.0 / 128.0));\n"
+    "  return floor((a * (256.0 - c2) + b * c2 + 128.0) * (1.0 / 256.0)); }\n";
+// SMS_VITA_FAST_SHADING=1 (sms-vita's menu, next start): the texel and
+// colour inputs are not rounded to whole 8-bit steps and the TEV's lerp is
+// a plain multiply-add, as MH3's fixed shading does: fewer instructions per
+// pixel, colours may differ by one step out of 255. Values are not whole
+// steps then, so the 8-bit wrap keeps -0.5..255.5 as it is (a value a hair
+// under 0 must not become 255) and comparison stages round their operands.
+// =2: the same in half precision (MH3's shaders use half too): whole steps
+// up to 2048 are exact in a half, more than the TEV's -1024..1023.
+static const char* kVitaFsHelpersFast =
+    "TEVF3 wrap256(TEVF3 v) { return v - 256.0 * floor(v * (1.0 / 256.0) + (0.5 / 256.0)); }\n"
+    "TEVF wrap256(TEVF v) { return v - 256.0 * floor(v * (1.0 / 256.0) + (0.5 / 256.0)); }\n"
+    "TEVF4 texi(float4 c) { return TEVF4(saturate(c) * 255.0); }\n"
+    "float2 projc(float4 t) { return t.xy / (t.z == 0.0 ? 1.0 : t.z); }\n"
+    "TEVF3 lerp3(TEVF3 a, TEVF3 b, TEVF3 c) { return a + (b - a) * (c * (1.0 / 255.0)); }\n"
+    "TEVF lerp1(TEVF a, TEVF b, TEVF c) { return a + (b - a) * (c * (1.0 / 255.0)); }\n";
+// 0: exact; 1: fast; 2: fast in half precision.
+static int vitaFastShading() {
+    static int level = -1;
+    if (level < 0) {
+        const char* e = getenv("SMS_VITA_FAST_SHADING");
+        level = e && *e ? atoi(e) : 0;
+        if (level < 0 || level > 2) level = 0;
+        if (level) logmsg("fast shading: TEV inputs not rounded, plain lerps%s", level == 2 ? ", half precision" : "");
+    }
+    return level;
+}
+// A TEV operand needs its low 8 bits taken (wrap256) only when it can be
+// outside 0..255: the colour registers (cprev, creg0-2). Textures,
+// rasterised colours, konsts and constants are always in range.
+static std::string vitaArg(const char* expr, bool reg) {
+    return reg ? std::string("wrap256(") + expr + ")" : std::string(expr);
+}
+
+static const char* kVitaColorArg[16] = {"cprev.rgb", "cprev.aaa", "creg0.rgb", "creg0.aaa", "creg1.rgb", "creg1.aaa",
+                                        "creg2.rgb", "creg2.aaa", "tex.rgb",   "tex.aaa",   "ras.rgb",   "ras.aaa",
+                                        "TEVF3(255.0, 255.0, 255.0)", "TEVF3(128.0, 128.0, 128.0)", "konst.rgb",
+                                        "TEVF3(0.0, 0.0, 0.0)"};
+static const char* kVitaAlphaArg[8] = {"cprev.a", "creg0.a", "creg1.a", "creg2.a", "tex.a", "ras.a", "konst.a", "0.0"};
+
+static std::string konstExprVita(uint32_t sel, bool alpha) {
+    static const int k8[8] = {255, 223, 191, 159, 127, 95, 63, 31};
+    if (sel < 8) return alpha ? strf("%d.0", k8[sel]) : strf("float3(%d.0, %d.0, %d.0)", k8[sel], k8[sel], k8[sel]);
+    if (!alpha && sel >= 12 && sel < 16) return strf("u_konst[%u].rgb", sel - 12);
+    if (sel >= 16) {
+        const char comp = "rgba"[(sel - 16) >> 2];
+        return alpha ? strf("u_konst[%u].%c", sel & 3, comp) : strf("u_konst[%u].%c%c%c", sel & 3, comp, comp, comp);
+    }
+    return alpha ? "255.0" : "float3(255.0, 255.0, 255.0)";
+}
+
+// An indirect stage's texture offset (`off`, in texels) from its indirect
+// lookup (ind<n>), as code for one block (the hardware's integer arithmetic,
+// see the GLSL generator).
+static std::string indOffsetCode(const ShaderKey& k, uint32_t ind) {
+    uint32_t bt = ind & 3, fmt = (ind >> 2) & 3, bias = (ind >> 4) & 7, mid = (ind >> 9) & 15;
+    static const int fmtSize[4] = {256, 32, 16, 8};
+    const uint32_t b = bt < k.numInd ? bt : 0;
+    std::string s = strf("    float3 iv = ind%u - %d.0 * floor(ind%u * (1.0 / %d.0));\n", b, fmtSize[fmt], b, fmtSize[fmt]);
+    int bv = fmt == 0 ? -128 : 1;
+    s += strf("    iv += float3(%d.0, %d.0, %d.0);\n", (bias & 1) ? bv : 0, (bias & 2) ? bv : 0, (bias & 4) ? bv : 0);
+    if (mid >= 1 && mid <= 3) {
+        uint32_t m = mid - 1;
+        s += strf("    float3 m0 = floor(u_indmtx[%u].xyz * 1024.0 + 0.5), m1 = floor(u_indmtx[%u].xyz * 1024.0 + 0.5);\n"
+                  "    float2 it = floor(float2(dot(m0, iv), dot(m1, iv)) * 0.125);\n"
+                  "    float sc = u_indmtx[%u].w;\n"
+                  "    it = sc >= 24.0 ? float2(0.0, 0.0) : sc >= 0.0 ? it * exp2(sc) : floor(it * exp2(sc));\n"
+                  "    it = it - 16777216.0 * floor((it + 8388608.0) * (1.0 / 16777216.0));\n"
+                  "    float2 off = it * (1.0 / 128.0);\n",
+                  m * 2, m * 2 + 1, m * 2);
+    } else {
+        s += "    float2 off = float2(0.0, 0.0);\n";
+    }
+    return s;
+}
+
+// GPU TEST (sms-vita's testing menu, next start; SMS_VITA_GPU_TEST): a
+// diagnostic that takes one kind of pixel work away, to see what the GPU's
+// time goes to (the picture is wrong meanwhile). 1: every pixel a flat grey
+// (no textures, no TEV, no alpha test); 2: textures read as flat grey (the
+// TEV and alpha test kept); 3: no alpha-test discard.
+static int vitaGpuTest() {
+    static int t = -1;
+    if (t < 0) {
+        const char* e = getenv("SMS_VITA_GPU_TEST");
+        t = e && *e ? atoi(e) : 0;
+        if (t < 0 || t > 3) t = 0;
+        if (t) logmsg("GPU TEST %d: %s", t, t == 1 ? "flat pixels" : t == 2 ? "no texture reads" : "no alpha-test discard");
+    }
+    return t;
+}
+
+static std::string genFSBody(const ShaderKey& k);
+static std::string genFS(const ShaderKey& k) {
+    std::string s = genFSBody(k);
+    if (vitaGpuTest() == 2) {  // every texture read a constant
+        for (size_t at = 0; (at = s.find("tex2D(", at)) != std::string::npos; at += 6) s.replace(at, 6, "smsTex(");
+        s = "float4 smsTex(sampler2D t, float2 c) { return float4(0.5, 0.5, 0.5, 1.0); }\n" + s;
+    }
+    return s;
+}
+static std::string genFSBody(const ShaderKey& k) {
+    const State& gd = *g_draw;  // (the drawing thread's copy when the draws run there)
+    const VitaUse use = vitaUse(k);
+    const int fast = vitaFastShading();
+    std::string s = fast == 2 ? kVitaFsTypesHalf : kVitaFsTypesFloat;
+    s += fast ? kVitaFsHelpersFast : kVitaFsHelpers;
+    s += "uniform float4 u_tevreg[4];\nuniform float4 u_konst[4];\nuniform float2 u_texscale[8];\n"
+         "uniform float2 u_texsize[8];\nuniform float2 u_alpharef;\nuniform float4 u_fog;\nuniform float4 u_fogcolor;\n"
+         "uniform float4 u_indmtx[6];\n";
+    if (k.earlyZ & 0x100) s += "uniform float u_dstalpha;\n";
+    for (int m = 0; m < 8; m++)
+        if (use.maps & (1u << m)) s += strf("uniform sampler2D u_tex%d;\n", m);
+    s += "float4 main(";
+    std::string args;
+    if (use.c0) args += ", float4 v_c0 : COLOR0";
+    if (use.c1) args += ", float4 v_c1 : COLOR1";
+    for (int t = 0; t < 8; t++)
+        if (use.coords & (1u << t)) args += strf(", float4 v_tc%d : TEXCOORD%d", t, t);
+    if (k.fogType) args += ", float2 v_z : TEXCOORD8";
+    s += args.empty() ? "" : args.substr(2);
+    s += ") : COLOR {\n";
+    if (k.depthOnly) return s + "  return float4(0.0, 0.0, 0.0, 0.0);\n}\n";
+    if (vitaGpuTest() == 1) return s + "  return float4(0.5, 0.5, 0.5, 1.0);\n}\n";
+    s += "  TEVF4 cprev = TEVF4(u_tevreg[0]), creg0 = TEVF4(u_tevreg[1]), creg1 = TEVF4(u_tevreg[2]),"
+         " creg2 = TEVF4(u_tevreg[3]);\n";
+    if (use.c0) s += "  TEVF4 ras0 = texi(v_c0);\n";
+    if (use.c1) s += "  TEVF4 ras1 = texi(v_c1);\n";
+    s += "  TEVF4 tex = TEVF4(255.0, 255.0, 255.0, 255.0), ras = TEVF4(0.0, 0.0, 0.0, 0.0), konst = ras;\n"
+         "  float bumpA = 0.0; float2 prevTc = float2(0.0, 0.0);\n";
+    // indirect texture lookups
+    for (uint32_t i = 0; i < k.numInd; i++) {
+        uint32_t map = (k.iref >> (6 * i)) & 7, coord = (k.iref >> (6 * i + 3)) & 7;
+        uint32_t ss = (gd.bp[i < 2 ? BP_RAS1_SS0 : BP_RAS1_SS1] >> ((i & 1) * 8)) & 0xFF;
+        s += strf("  float3 ind%u = float3(texi(tex2D(u_tex%u, projc(v_tc%u) / float2(%d.0, %d.0))).abg);\n", i, map, coord,
+                  1 << (ss & 15), 1 << ((ss >> 4) & 15));
+    }
+    // Each indirect offset (its texture, format, bias and matrix) computed
+    // once, before the stages: several stages often share one, and repeating
+    // it made the compiler fail on long programs ("fatal internal error").
+    std::vector<std::string> offCodes;
+    auto offIndex = [&](const std::string& code) {
+        for (size_t i = 0; i < offCodes.size(); i++)
+            if (offCodes[i] == code) return int(i);
+        return -1;
+    };
+    for (uint32_t st = 0; st < k.numStages; st++) {
+        if (!((k.order[st] >> 6) & 1) || !k.ind[st]) continue;
+        std::string code = indOffsetCode(k, k.ind[st]);
+        if (offIndex(code) >= 0) continue;
+        s += strf("  float2 off%d;\n  {\n", int(offCodes.size())) + code +
+             strf("    off%d = off;\n  }\n", int(offCodes.size()));
+        offCodes.push_back(code);
+    }
+    uint32_t lastDest = 0, lastA = 0;
+    // A register whose last write was clamped (0..255) needs no 8-bit wrap
+    // when read: wrap256 is the identity there (exact; most of the game's
+    // stages clamp). The uniforms' initial values may be anything.
+    bool cIn[4] = {false, false, false, false}, aIn[4] = {false, false, false, false};
+    auto colorReg = [&](uint32_t a) { return a < 8 && !((a & 1) ? aIn[a >> 1] : cIn[a >> 1]); };
+    auto alphaReg = [&](uint32_t a) { return a < 4 && !aIn[a]; };
+    for (uint32_t st = 0; st < k.numStages; st++) {
+        uint32_t ord = k.order[st];
+        uint32_t map = ord & 7, coord = (ord >> 3) & 7, en = (ord >> 6) & 1, chan = (ord >> 7) & 7;
+        uint32_t ce = k.colorEnv[st], ae = k.alphaEnv[st];
+        uint32_t rasSwap = k.swap[ae & 3], texSwap = k.swap[(ae >> 2) & 3];
+        s += strf("  // stage %u\n  {\n", st);
+        uint32_t ind = k.ind[st];
+        if (en) {
+            if (ind) {
+                uint32_t bt = ind & 3, bs = (ind >> 7) & 3, sw = (ind >> 13) & 7, tw = (ind >> 16) & 7,
+                         fb = (ind >> 20) & 1;
+                const uint32_t b = bt < k.numInd ? bt : 0;
+                if (bs) {
+                    const char c = "xxyz"[bs];
+                    s += strf("    bumpA = ind%u.%c - (ind%u.%c - 8.0 * floor(ind%u.%c * 0.125));\n", b, c, b, c, b, c);
+                }
+                s += strf("    float2 off = off%d;\n", offIndex(indOffsetCode(k, ind)));
+                s += strf("    float2 tcx = projc(v_tc%u) * u_texscale[%u] * u_texsize[%u];\n", coord, coord, map);
+                static const int wrapSize[8] = {0, 256, 128, 64, 32, 16, 0, 0};
+                if (sw == 6) s += "    tcx.x = 0.0;\n";
+                else if (sw) s += strf("    tcx.x -= %d.0 * floor(tcx.x * (1.0 / %d.0));\n", wrapSize[sw], wrapSize[sw]);
+                if (tw == 6) s += "    tcx.y = 0.0;\n";
+                else if (tw) s += strf("    tcx.y -= %d.0 * floor(tcx.y * (1.0 / %d.0));\n", wrapSize[tw], wrapSize[tw]);
+                s += strf("    tcx += off%s; prevTc = tcx;\n", fb ? " + prevTc" : "");
+                s += strf("    tex = texi(tex2D(u_tex%u, tcx / u_texsize[%u])).%s;\n", map, map, swizzle(texSwap).c_str());
+            } else {
+                s += strf("    tex = texi(tex2D(u_tex%u, projc(v_tc%u) * u_texscale[%u])).%s;\n", map, coord, coord,
+                          swizzle(texSwap).c_str());
+            }
+        }
+        if (chan == 0) s += strf("    ras = ras0.%s;\n", swizzle(rasSwap).c_str());
+        else if (chan == 1) s += strf("    ras = ras1.%s;\n", swizzle(rasSwap).c_str());
+        else if (chan == 5) s += "    ras = TEVF4(bumpA, bumpA, bumpA, bumpA);\n";
+        else if (chan == 6) s += "    ras = TEVF4((bumpA + floor(bumpA * (1.0 / 32.0))) * float4(1.0, 1.0, 1.0, 1.0));\n";
+        else s += "    ras = TEVF4(0.0, 0.0, 0.0, 0.0);\n";
+        uint32_t kc = k.ksel[st] & 31, ka = (k.ksel[st] >> 5) & 31;
+        s += strf("    konst = TEVF4(%s, %s);\n", konstExprVita(kc, false).c_str(), konstExprVita(ka, true).c_str());
+
+        // colour
+        {
+            uint32_t d = ce & 15, c = (ce >> 4) & 15, b = (ce >> 8) & 15, a = (ce >> 12) & 15;
+            uint32_t bias = (ce >> 16) & 3, op = (ce >> 18) & 1, clampv = (ce >> 19) & 1, scale = (ce >> 20) & 3,
+                     dest = (ce >> 22) & 3;
+            if (bias != 3) {
+                s += strf("    TEVF3 A = %s, B = %s, Cc = %s, D = %s;\n", vitaArg(kVitaColorArg[a], colorReg(a)).c_str(),
+                          vitaArg(kVitaColorArg[b], colorReg(b)).c_str(), vitaArg(kVitaColorArg[c], colorReg(c)).c_str(),
+                          kVitaColorArg[d]);
+            } else {
+                // a comparison: in float (its 16- and 24-bit sums overflow a
+                // half), and on whole steps with fast shading
+                const char* rnd = fast ? "floor(" : "";
+                const char* rndEnd = fast ? " + 0.5)" : "";
+                s += strf("    float3 A = %sfloat3(%s)%s, B = %sfloat3(%s)%s, Cc = float3(%s), D = float3(%s);\n", rnd,
+                          vitaArg(kVitaColorArg[a], colorReg(a)).c_str(), rndEnd, rnd, vitaArg(kVitaColorArg[b], colorReg(b)).c_str(),
+                          rndEnd, vitaArg(kVitaColorArg[c], colorReg(c)).c_str(), kVitaColorArg[d]);
+            }
+            if (bias != 3) {
+                s += strf("    TEVF3 r = D %c lerp3(A, B, Cc)%s;\n", op ? '-' : '+',
+                          bias == 1 ? " + 128.0" : bias == 2 ? " - 128.0" : "");
+                if (scale == 1) s += "    r *= 2.0;\n";
+                else if (scale == 2) s += "    r *= 4.0;\n";
+                else if (scale == 3) s += "    r = floor(r * 0.5);\n";
+            } else {
+                uint32_t mode = (scale << 1) | op;
+                const char* cond;
+                switch (mode) {
+                case 0: cond = "A.r > B.r ? 1.0 : 0.0"; break;
+                case 1: cond = "A.r == B.r ? 1.0 : 0.0"; break;
+                case 2: cond = "(A.g * 256.0 + A.r) > (B.g * 256.0 + B.r) ? 1.0 : 0.0"; break;
+                case 3: cond = "(A.g * 256.0 + A.r) == (B.g * 256.0 + B.r) ? 1.0 : 0.0"; break;
+                case 4: cond = "(A.b * 65536.0 + A.g * 256.0 + A.r) > (B.b * 65536.0 + B.g * 256.0 + B.r) ? 1.0 : 0.0"; break;
+                case 5: cond = "(A.b * 65536.0 + A.g * 256.0 + A.r) == (B.b * 65536.0 + B.g * 256.0 + B.r) ? 1.0 : 0.0"; break;
+                case 6: cond = nullptr; break;  // per component
+                default: cond = nullptr; break;
+                }
+                if (cond) s += strf("    float3 r = D + (%s) * Cc;\n", cond);
+                else if (mode == 6) s += "    float3 r = D + float3(A.r > B.r ? 1.0 : 0.0, A.g > B.g ? 1.0 : 0.0, A.b > B.b ? 1.0 : 0.0) * Cc;\n";
+                else s += "    float3 r = D + float3(A.r == B.r ? 1.0 : 0.0, A.g == B.g ? 1.0 : 0.0, A.b == B.b ? 1.0 : 0.0) * Cc;\n";
+            }
+            s += strf("    %s.rgb = TEVF3(clamp(r, %s));\n", kRegName[dest], clampv ? "0.0, 255.0" : "-1024.0, 1023.0");
+            lastDest = dest;
+            cIn[dest] = clampv != 0;
+        }
+        // alpha
+        {
+            uint32_t d = (ae >> 4) & 7, c = (ae >> 7) & 7, b = (ae >> 10) & 7, a = (ae >> 13) & 7;
+            uint32_t bias = (ae >> 16) & 3, op = (ae >> 18) & 1, clampv = (ae >> 19) & 1, scale = (ae >> 20) & 3,
+                     dest = (ae >> 22) & 3;
+            if (bias != 3) {
+                s += strf("    TEVF Aa = %s, Ba = %s, Ca = %s, Da = %s;\n", vitaArg(kVitaAlphaArg[a], alphaReg(a)).c_str(),
+                          vitaArg(kVitaAlphaArg[b], alphaReg(b)).c_str(), vitaArg(kVitaAlphaArg[c], alphaReg(c)).c_str(),
+                          kVitaAlphaArg[d]);
+            } else {
+                const char* rnd = fast ? "floor(" : "";
+                const char* rndEnd = fast ? " + 0.5)" : "";
+                s += strf("    float Aa = %sfloat(%s)%s, Ba = %sfloat(%s)%s, Ca = float(%s), Da = float(%s);\n", rnd,
