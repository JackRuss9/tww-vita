From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 18:55:30 +0100
Subject: [PATCH] Reason: build on 32-bit x86 PCs (the fiber stack dump only
 where fibers exist); OSSetSwitchThreadCallback, called on every thread switch
 (Wind Waker keeps each thread's current heap with it); the window title is
 the game's (port_window_title); a read past a file's end returns the whole
 length, zero-filled, as the drive does (Wind Waker's JKRFile::read retries
 until it gets it)

---
 platform/dvd/dvd.cpp            | 11 +++++++++++
 platform/gx/src/gx_platform.cpp | 11 +++++++----
 platform/os/os_thread.cpp       | 18 ++++++++++++++++++
 3 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/platform/dvd/dvd.cpp b/platform/dvd/dvd.cpp
index 138c87c..51e3d6e 100644
--- a/platform/dvd/dvd.cpp
+++ b/platform/dvd/dvd.cpp
@@ -278,6 +278,17 @@ extern "C" __attribute__((weak)) void GXPC_MemoryWritten(const void* p, u32 n);
 s32 do_read(DVDFileInfo* fi, void* addr, s32 length, s32 offset)
 {
 	s32 n = do_read_raw(fi, addr, length, offset);
+	// The drive reads whole 32-byte blocks: a read that starts inside a file
+	// and runs past its end (games round the length up to 32, Wind Waker's
+	// JKRFileCache always) gets everything asked for, the rest being what
+	// follows on the disc. Zeros here, and the full length reported:
+	// JKRFile::read retries until it gets exactly what it asked for.
+	if (n >= 0 && n < length && fi->startAddr < g_fst.size() &&
+	    (u32)offset + (u32)n >= g_fst[fi->startAddr].length) {
+		memset((u8*)addr + n, 0, (size_t)(length - n));
+		n = length;
+		fi->cb.transferredSize = n;
+	}
 	if (n > 0 && GXPC_MemoryWritten)
 		GXPC_MemoryWritten(addr, (u32)n);
 	return n;
diff --git a/platform/gx/src/gx_platform.cpp b/platform/gx/src/gx_platform.cpp
index e47fd0d..85cc68b 100644
--- a/platform/gx/src/gx_platform.cpp
+++ b/platform/gx/src/gx_platform.cpp
@@ -5,6 +5,9 @@
 // surface.  GXInit brings this up automatically if the host has not called
 // GXPC_Init itself, and every GXCopyDisp presents the XFB to the window.
 #include "gx_internal.h"
+// The window's title: the game's name (a port of another game defines its
+// own; this one is the default).
+extern "C" __attribute__((weak)) const char* port_window_title = "Super Mario Sunshine";
 #include "gx_cheat_menu.h"
 #include "gx_warp_menu.h"
 #include "gx_quit_prompt.h"
@@ -397,7 +400,7 @@ bool openWindow(float scale) {
             layout.h = h;
         }
     }
-    s_window = SDL_CreateWindow("Super Mario Sunshine", layout.x, layout.y, layout.w, layout.h,
+    s_window = SDL_CreateWindow(port_window_title, layout.x, layout.y, layout.w, layout.h,
                                 SDL_WINDOW_OPENGL | SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI |
                                 SDL_WINDOW_HIDDEN);
     if (!s_window) {
@@ -793,11 +796,11 @@ int GXPC_InitAuto(float efbScale) {
             // still run without a window.
             char msg[512];
             snprintf(msg, sizeof msg,
-                     "Super Mario Sunshine could not open its window (%s).\n\nUpdating your graphics drivers, or "
+                     "%s could not open its window (%s).\n\nUpdating your graphics drivers, or "
                      "setting SDL_VIDEODRIVER=x11 or =wayland, may help.",
-                     s_windowError);
+                     port_window_title, s_windowError);
             logmsg("no window could be opened on this display (%s); exiting", s_windowError);
-            SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Super Mario Sunshine", msg, nullptr);
+            SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, port_window_title, msg, nullptr);
             exit(1);
         }
         logmsg("no display (%s), continuing headless", s_windowError);
diff --git a/platform/os/os_thread.cpp b/platform/os/os_thread.cpp
index 4a8a515..5b22ca7 100644
--- a/platform/os/os_thread.cpp
+++ b/platform/os/os_thread.cpp
@@ -588,10 +588,19 @@ void fiber_forget(Host* h)
 #endif
 }
 
+// OSSetSwitchThreadCallback: called on every switch, on the outgoing thread
+// before `next` runs. JSystem's JKRThreadSwitch keeps each thread's current
+// heap with it (Wind Waker's DVD thread sets its own to NULL); Sunshine set
+// none.
+typedef void (*SwitchThreadCallback)(OSThread* from, OSThread* to);
+SwitchThreadCallback g_switch_cb;
+
 // Hand the CPU to `next` (already chosen). Returns once `self` owns the CPU
 // again, or never if `self` is exiting.
 void switch_to(OSThread* self, OSThread* next, bool exiting)
 {
+	if (g_switch_cb && self != next)
+		g_switch_cb(self == &g_default_thread ? NULL : self, next == &g_default_thread ? NULL : next);
 #ifdef PORT_HAVE_FIBERS
 	if (g_fibers) {
 		fiber_switch(self, next, exiting);
@@ -997,6 +1006,7 @@ extern "C" void port_os_dump_threads(unsigned lo, unsigned hi)
 		int n = snprintf(line, sizeof line, "[os] thread %p: entry %p, state %d, priority %d, suspend %d%s; stack:",
 		                 (void*)t, (void*)h->func, (int)t->state, (int)t->priority, (int)t->suspend,
 		                 t == cur ? " (running)" : "");
+#ifdef PORT_HAVE_FIBERS
 		if (g_fibers && t != cur && h->fiber_sp) {
 			const u32* p = (const u32*)h->fiber_sp;
 			const u32* end = h->fiber_stack ? (const u32*)(h->fiber_stack + kFiberStack) : p + 4096;
@@ -1011,6 +1021,7 @@ extern "C" void port_os_dump_threads(unsigned lo, unsigned hi)
 				}
 			}
 		}
+#endif
 		port_log("%s\n", line);
 	}
 }
@@ -1473,3 +1484,10 @@ extern "C" PORT_ASM_CALLED void port_fiber_entry(void* thread)
 	void* ret = h->func(h->arg);
 	OSExitThread((OSThread*)ret);
 }
+
+extern "C" void* OSSetSwitchThreadCallback(void* callback)
+{
+	SwitchThreadCallback prev = g_switch_cb;
+	g_switch_cb = (SwitchThreadCallback)callback;
+	return (void*)prev;
+}
