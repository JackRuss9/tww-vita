 int port_endian_aaf(void* data, uint32_t size);
 int port_endian_ibnk(void* data, uint32_t size);
 int port_endian_wsys(void* data, uint32_t size);
diff --git a/platform/gx/src/gx_platform.cpp b/platform/gx/src/gx_platform.cpp
index e47fd0d..85cc68b 100644
--- a/platform/gx/src/gx_platform.cpp
+++ b/platform/gx/src/gx_platform.cpp
@@ -5,6 +5,9 @@
 // surface.  GXInit brings this up automatically if the host has not called
 // GXPC_Init itself, and every GXCopyDisp presents the XFB to the window.
 #include "gx_internal.h"
+// The window's title: the game's name (a port of another game defines its
+// own; this one is the default).
+extern "C" __attribute__((weak)) const char* port_window_title = "Super Mario Sunshine";
 #include "gx_cheat_menu.h"
 #include "gx_warp_menu.h"
 #include "gx_quit_prompt.h"
@@ -397,7 +400,7 @@ bool openWindow(float scale) {
             layout.h = h;
         }
     }
-    s_window = SDL_CreateWindow("Super Mario Sunshine", layout.x, layout.y, layout.w, layout.h,
