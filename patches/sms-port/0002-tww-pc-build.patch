From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 18:55:30 +0100
Subject: [PATCH] Reason: build on 32-bit x86 PCs (the fiber stack dump only
 where fibers exist); OSSetSwitchThreadCallback, called on every thread switch
 (Wind Waker keeps each thread's current heap with it); the window title is
 the game's (port_window_title); a read past a file's end returns the whole
 length, zero-filled, as the drive does (Wind Waker's JKRFile::read retries
 until it gets it); J3D: the MDL3 block (BDL material display lists, read by
 Wind Waker's J3D) converted; JPAC1-00 particle archives (Wind Waker)
 converted with Wind Waker's own JParticle block layouts (BSP1, ESP1, SSP1,
 ETX1, KFA1, BEM1, FLD1, TDB1, TEX1)

---
 platform/dvd/dvd.cpp                |  11 +++
 platform/endian/endian_dispatch.cpp |   4 +
 platform/endian/endian_j3d.cpp      |  30 +++++-
 platform/endian/endian_jpa.cpp      | 138 ++++++++++++++++++++++++++++
 platform/endian/port_endian.h       |   1 +
 platform/gx/src/gx_platform.cpp     |  11 ++-
 platform/os/os_thread.cpp           |  18 ++++
 7 files changed, 208 insertions(+), 5 deletions(-)

diff --git a/platform/dvd/dvd.cpp b/platform/dvd/dvd.cpp
index 138c87c..51e3d6e 100644
--- a/platform/dvd/dvd.cpp
+++ b/platform/dvd/dvd.cpp
@@ -278,6 +278,17 @@ extern "C" __attribute__((weak)) void GXPC_MemoryWritten(const void* p, u32 n);
 s32 do_read(DVDFileInfo* fi, void* addr, s32 length, s32 offset)
 {
 	s32 n = do_read_raw(fi, addr, length, offset);
+	// The drive reads whole 32-byte blocks: a read that starts inside a file
+	// and runs past its end (games round the length up to 32, Wind Waker's
+	// JKRFileCache always) gets everything asked for, the rest being what
+	// follows on the disc. Zeros here, and the full length reported:
+	// JKRFile::read retries until it gets exactly what it asked for.
+	if (n >= 0 && n < length && fi->startAddr < g_fst.size() &&
+	    (u32)offset + (u32)n >= g_fst[fi->startAddr].length) {
+		memset((u8*)addr + n, 0, (size_t)(length - n));
+		n = length;
+		fi->cb.transferredSize = n;
+	}
 	if (n > 0 && GXPC_MemoryWritten)
 		GXPC_MemoryWritten(addr, (u32)n);
 	return n;
diff --git a/platform/endian/endian_dispatch.cpp b/platform/endian/endian_dispatch.cpp
index a729d7b..5942588 100644
--- a/platform/endian/endian_dispatch.cpp
+++ b/platform/endian/endian_dispatch.cpp
@@ -55,6 +55,10 @@ static int resource(void* data, uint32_t size, const char* name)
 		return port_endian_jpa(data, size) ? PE_FMT_JPA : PE_FMT_UNKNOWN;
 	if (magic_rev(d, "JEFF", 4) && magic_rev(d + 4, "jpa1", 4))
 		return PE_FMT_ALREADY_NATIVE;
+	if (magic_is(d, "JPAC1-00", 8))
+		return port_endian_jpc(data, size) ? PE_FMT_JPA : PE_FMT_UNKNOWN;
+	if (magic_rev(d, "JPAC", 4) && magic_rev(d + 4, "1-00", 4))
+		return PE_FMT_ALREADY_NATIVE;
 	if (magic_is(d, "IBNK", 4))
 		return port_endian_ibnk(data, size) ? PE_FMT_BNK : PE_FMT_UNKNOWN;
 	if (magic_is(d, "WSYS", 4))
diff --git a/platform/endian/endian_j3d.cpp b/platform/endian/endian_j3d.cpp
index e79b55e..87b0505 100644
--- a/platform/endian/endian_j3d.cpp
+++ b/platform/endian/endian_j3d.cpp
@@ -558,6 +558,34 @@ static void anm_block(const Buf& b, u32 tag)
 
 // --- File level ---------------------------------------------------------------------
 
+// MDL3: BDL material display lists (read by Wind Waker's J3D, not
+// Sunshine's): u16 count; offsets to {u32 offset, u32 size} per material
+// (the display list, relative to its own entry), the patching offsets
+// (6 x u16 + 4 bytes), the current matrix registers (2 x u32), the material
+// modes (u8), an unread table, the names. The display lists are GX command
+// bytes, read big-endian: left as they are.
+static void mdl3(const Buf& b)
+{
+	if (!b.has(0, 0x24))
+		return;
+	u16 n = b.sw16(0x08);
+	u32 dl  = b.sw32(0x0C);
+	u32 pat = b.sw32(0x10);
+	u32 mtx = b.sw32(0x14);
+	b.sw32(0x18); // material modes (u8)
+	b.sw32(0x1C);
+	u32 names = b.sw32(0x20);
+	for (u32 i = 0; i < n; i++) {
+		if (dl && b.has(dl + i * 8, 8))
+			b.swn(dl + i * 8, 2, 4);
+		if (pat && b.has(pat + i * 0x10, 0x10))
+			b.swn(pat + i * 0x10, 6, 2);
+		if (mtx && b.has(mtx + i * 8, 8))
+			b.swn(mtx + i * 8, 2, 4);
+	}
+	ntab(b, names);
+}
+
 static bool j3d_magic_be(const u8* d)
 {
 	return magic_is(d, "J3D1", 4) || magic_is(d, "J3D2", 4);
@@ -592,7 +620,7 @@ extern "C" int port_endian_j3d(void* data, uint32_t size)
 		case 'MAT3': mat(b, false); break;
 		case 'MAT2': mat(b, true); break;
 		case 'TEX1': tex1(b); break;
-		case 'MDL3': break; // BDL material display lists: not read by this J3D version
+		case 'MDL3': mdl3(b); break; // BDL material display lists (Wind Waker's J3D reads them)
 		default: anm_block(b, tag); break;
 		}
 		pos += bsz;
diff --git a/platform/endian/endian_jpa.cpp b/platform/endian/endian_jpa.cpp
index 3c15fc7..65e3123 100644
--- a/platform/endian/endian_jpa.cpp
+++ b/platform/endian/endian_jpa.cpp
@@ -83,3 +83,141 @@ extern "C" int port_endian_jpa(void* data, uint32_t size)
 	}
 	return 1;
 }
+
+// --- JPAC1-00: Wind Waker's particle archives ------------------------------------
+// u32 'JPAC', u32 '1-00', u16 emitter count, u16 texture count, then (from
+// 0x20) the emitters, each a JEFFjpa1 header (0x20: block count at 0x0C,
+// key/field/texture counts as u8 at 0x14, resource ID u16 at 0x18) and its
+// blocks; then the textures, TEX1 blocks one after another
+// (JPAEmitterArchiveLoader_v10). Wind Waker's JParticle is another version
+// than Sunshine's: its blocks are read as structs at +0x0C (JPA*Arc), with
+// their own layouts (JPABaseShapeData etc.), converted here.
+namespace {
+
+const u32 D = 0x0C; // block data
+
+void ww_bsp1(const Buf& b) // JPABaseShapeData, 0x54
+{
+	if (!b.has(D, 0x54))
+		return;
+	b.sw32(D + 0x00);       // flags
+	b.swn(D + 0x04, 2, 2);  // prm/env colour key offsets (from the block start)
+	b.swn(D + 0x08, 2, 4);  // base size x/y
+	b.swn(D + 0x10, 2, 2);  // loop offset, blend flags
+	b.sw16(D + 0x1E);       // colour anim max frame
+	b.swn(D + 0x28, 11, 4); // tiling, static/scroll transforms
+	// colour keys {s16 frame, GXColor}: 6 bytes each
+	u32 prm = (u16)ld16(b.at(D + 0x04)), env = (u16)ld16(b.at(D + 0x06));
+	u8 nprm = b.base[D + 0x1C], nenv = b.base[D + 0x1D];
+	for (u32 i = 0; prm && i < nprm && b.has(prm + i * 6, 6); i++)
+		b.sw16(prm + i * 6);
+	for (u32 i = 0; env && env != prm && i < nenv && b.has(env + i * 6, 6); i++)
+		b.sw16(env + i * 6);
+}
+
+void ww_esp1(const Buf& b) // JPAExtraShapeData, 0x60
+{
+	if (!b.has(D, 0x60))
+		return;
+	b.swn(D + 0x00, 18, 4); // flags, 0x04, alpha and scale parameters
+	b.swn(D + 0x48, 2, 2);  // anim cycle x/y
+	b.swn(D + 0x4C, 5, 4);  // rotation
+}
+
+void ww_ssp1(const Buf& b) // JPASweepShapeData, 0x48
+{
+	if (!b.has(D, 0x48))
+		return;
+	b.swn(D + 0x00, 7, 4); // flags, position/velocity, gravity, timing
+	b.swn(D + 0x1C, 2, 2); // life, rate
+	b.swn(D + 0x24, 6, 4); // scale, rotate speed, inherit rates
+	// colours (RGBA bytes) and texture index stay
+}
+
+void ww_etx1(const Buf& b) // JPAExTexShapeData, 0x24
+{
+	if (!b.has(D, 0x24))
+		return;
+	b.swn(D + 0x00, 7, 4); // flags, indirect texture matrix (2x3 floats)
+}
+
+void ww_kfa1(const Buf& b) // JPAKeyBlockData (bytes), then f32 keys from 0x20
+{
+	if (b.size > 0x20)
+		b.swn(0x20, (b.size - 0x20) / 4, 4);
+}
+
+void ww_bem1(const Buf& b) // JPADynamicsBlockData, 0x80
+{
+	if (!b.has(D, 0x80))
+		return;
+	b.swn(D + 0x00, 3, 4);  // flags, sweep, min radius
+	b.swn(D + 0x0C, 2, 2);  // volume size, division number
+	b.swn(D + 0x10, 2, 4);  // rate, rate random
+	b.swn(D + 0x1A, 3, 2);  // max frame, start frame, life time
+	b.swn(D + 0x20, 22, 4); // 0x20..0x77: floats and three float vectors
+	b.swn(D + 0x78, 3, 2);  // emitter rotation (s16 x 3)
+}
+
+void ww_fld1(const Buf& b) // JPAFieldBlockData
+{
+	if (!b.has(D, 0x45))
+		return;
+	b.swn(D, 17, 4); // flags, then 16 floats; the cycle (u8) at 0x44 stays
+}
+
+void ww_tdb1(const Buf& b) // u16 texture indices
+{
+	if (b.size > D)
+		b.swn(D, (b.size - D) / 2, 2);
+}
+
+} // namespace
+
+extern "C" int port_endian_jpc(void* data, uint32_t size)
+{
+	Buf f(data, size);
+	if (!f.has(0, 0x20) || !magic_is(data, "JPAC1-00", 8))
+		return 0;
+	f.swn(0, 2, 4);
+	u16 nemtr = f.sw16(0x08);
+	u16 ntex  = f.sw16(0x0A);
+	u32 offs  = 0x20;
+	for (u32 e = 0; e < nemtr && f.has(offs, 0x20); e++) {
+		if (!magic_is(f.at(offs), "JEFFjpa1", 8))
+			return 1; // not where an emitter should be: stop
+		f.swn(offs, 4, 4);  // magic, type, ?, block count
+		f.sw16(offs + 0x18); // resource ID
+		u32 nblk = ld32(f.at(offs + 0x0C));
+		u32 pos  = offs + 0x20;
+		for (u32 i = 0; i < nblk && f.has(pos, 8); i++) {
+			u32 tag = f.sw32(pos);
+			u32 sz  = f.sw32(pos + 4);
+			if (sz < 8 || !f.has(pos, sz))
+				return 1;
+			Buf blk = f.sub(pos, sz);
+			switch (tag) {
+			case 'BSP1': ww_bsp1(blk); break;
+			case 'ESP1': ww_esp1(blk); break;
+			case 'SSP1': ww_ssp1(blk); break;
+			case 'ETX1': ww_etx1(blk); break;
+			case 'KFA1': ww_kfa1(blk); break;
+			case 'BEM1': ww_bem1(blk); break;
+			case 'FLD1': ww_fld1(blk); break;
+			case 'TDB1': ww_tdb1(blk); break;
+			default: break;
+			}
+			pos += sz;
+		}
+		offs = pos;
+	}
+	for (u32 t = 0; t < ntex && f.has(offs, 0x40); t++) {
+		f.sw32(offs); // 'TEX1'
+		u32 sz = f.sw32(offs + 4);
+		port_endian_timg_header(f.at(offs + 0x20));
+		if (sz < 8 || !f.has(offs, sz))
+			break;
+		offs += sz;
+	}
+	return 1;
+}
diff --git a/platform/endian/port_endian.h b/platform/endian/port_endian.h
index 8f191f1..ba59634 100644
--- a/platform/endian/port_endian.h
+++ b/platform/endian/port_endian.h
@@ -47,6 +47,7 @@ int port_endian_timg_header(void* timg);                 /* 0x20-byte ResTIMG he
 int port_endian_tlut(void* data, uint32_t size);          /* ResTLUT header (.bpl) */
 int port_endian_ntab(void* ntab, uint32_t size);          /* ResNTAB */
 int port_endian_jpa(void* data, uint32_t size);
