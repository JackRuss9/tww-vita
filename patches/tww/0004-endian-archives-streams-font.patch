From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 11:42:10 +0100
Subject: [PATCH] Reason: endian: the disc's big-endian data read in place:
 RARC headers and tables when an archive (memory, ARAM, DVD, compressed) is
 opened, each resource when first fetched (port_res_to_native_named, as in the
 Sunshine port's 0011), the Yaz0 length, the JSU stream's typed reads (as
 0013), and a converted copy of the embedded system font

---
 include/JSystem/JSupport/JSUInputStream.h | 37 +++++++++++++++++------
 src/JSystem/JFramework/JFWSystem.cpp      | 11 +++++++
 src/JSystem/JKernel/JKRAram.cpp           |  2 +-
 src/JSystem/JKernel/JKRAramArchive.cpp    |  4 +++
 src/JSystem/JKernel/JKRCompArchive.cpp    |  7 +++++
 src/JSystem/JKernel/JKRDvdAramRipper.cpp  |  2 +-
 src/JSystem/JKernel/JKRDvdArchive.cpp     |  4 +++
 src/JSystem/JKernel/JKRDvdRipper.cpp      |  2 +-
 src/JSystem/JKernel/JKRMemArchive.cpp     |  4 +++
 9 files changed, 60 insertions(+), 13 deletions(-)

diff --git a/include/JSystem/JSupport/JSUInputStream.h b/include/JSystem/JSupport/JSUInputStream.h
index 46cf4cc4..9fa8e1dc 100644
--- a/include/JSystem/JSupport/JSUInputStream.h
+++ b/include/JSystem/JSupport/JSUInputStream.h
@@ -12,33 +12,50 @@ public:
     /* vt[4] */ virtual s32 skip(s32);
     /* vt[5] */ virtual u32 readData(void*, s32) = 0;
 
+#ifdef TARGET_PC
+    // The streams carry the disc's big-endian data: the typed reads of
+    // 16- and 32-bit values convert to host order.
+    s32 readBE(void* buf, s32 size) {
+        s32 r = read(buf, size);
+        u8* b = (u8*)buf;
+        for (s32 i = 0; i < size / 2; i++) {
+            u8 c = b[i];
+            b[i] = b[size - 1 - i];
+            b[size - 1 - i] = c;
+        }
+        return r;
+    }
+#else
+    s32 readBE(void* buf, s32 size) { return read(buf, size); }
+#endif
+
     u32 readU32() {
         u32 val;
-        this->read(&val, sizeof(val));
+        this->readBE(&val, sizeof(val));
         return val;
     }
 
     u32 read32b() {
         u32 val;
-        this->read(&val, sizeof(val));
+        this->readBE(&val, sizeof(val));
         return val;
     }
 
     s32 readS32() {
         s32 val;
-        this->read(&val, sizeof(val));
+        this->readBE(&val, sizeof(val));
         return val;
     }
 
     s16 readS16() {
         s16 val;
-        this->read(&val, sizeof(val));
+        this->readBE(&val, sizeof(val));
         return val;
     }
 
     u16 readU16() {
         u16 val;
-        this->read(&val, sizeof(val));
+        this->readBE(&val, sizeof(val));
         return val;
     }
 
@@ -56,17 +73,17 @@ public:
 
     u16 read16b() {
         u16 val;
-        this->read(&val, sizeof(val));
+        this->readBE(&val, sizeof(val));
         return val;
     }
 
     JSUInputStream& operator>>(u32& dest) {
-        read(&dest, 4);
+        readBE(&dest, 4);
         return *this;
     }
 
     JSUInputStream& operator>>(u16& dest) {
-        read(&dest, 2);
+        readBE(&dest, 2);
         return *this;
     }
 
@@ -76,7 +93,7 @@ public:
     }
 
     JSUInputStream& operator>>(s16& dest) {
-        read(&dest, 2);
+        readBE(&dest, 2);
         return *this;
     }
 
@@ -89,7 +106,7 @@ public:
 
     s32 read(u8& val) { return read(&val, sizeof(u8)); }
 
-    s32 read(u32& param_0) { return read(&param_0, 4); }
+    s32 read(u32& param_0) { return readBE(&param_0, 4); }
 
     // TODO: return value probably wrong
     s32 read(void*, s32);
diff --git a/src/JSystem/JFramework/JFWSystem.cpp b/src/JSystem/JFramework/JFWSystem.cpp
index b9480c39..39100697 100644
--- a/src/JSystem/JFramework/JFWSystem.cpp
+++ b/src/JSystem/JFramework/JFWSystem.cpp
@@ -80,6 +80,17 @@ void JFWSystem::init() {
     JUTAssertion::create();
     JUTException::create(dirPrint);
 
+#ifdef TARGET_PC
+    // The font is embedded big-endian and read-only: convert a copy.
+    {
+        const u8* res = (const u8*)CSetUpParam::systemFontRes;
+        const u32 size = port_be32(res + 8);
+        void* copy = JKRAllocFromSysHeap(size, 32);
+        memcpy(copy, res, size);
+        port_res_to_native_named(copy, size, "system font");
+        CSetUpParam::systemFontRes = (ResFONT*)copy;
+    }
+#endif
     systemFont = new JUTResFont(CSetUpParam::systemFontRes, 0);
 
     debugPrint = JUTDbPrint::start(0, 0);
