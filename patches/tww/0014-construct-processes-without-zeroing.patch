From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 19:14:47 +0100
Subject: [PATCH 2/2] Reason: construct actors and effect processes without
 zeroing them

`new (p) T()` on a class without a constructor of its own value-initialises
it: GCC zero-fills the whole object first (the GameCube compiler did not),
wiping the process header the framework set up (its method table), so
deleting an actor whose create failed crashed (the title scene's ship).
`new (p) T` runs the same constructors without the zero fill; the framework
already cleared the memory.
---
 include/f_op/f_op_actor_mng.h | 2 +-
 src/d/d_ky_thunder.cpp        | 2 +-
 src/d/d_s_name.cpp            | 2 +-
 src/d/d_water_mark.cpp        | 2 +-
 src/d/d_wind_arrow.cpp        | 2 +-
 src/d/d_wpillar.cpp           | 2 +-
 src/d/d_wpot_water.cpp        | 2 +-
 7 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/include/f_op/f_op_actor_mng.h b/include/f_op/f_op_actor_mng.h
index b585603a..f4c8478d 100644
--- a/include/f_op/f_op_actor_mng.h
+++ b/include/f_op/f_op_actor_mng.h
@@ -14,7 +14,7 @@
 // The name of this macro is official and comes from a TP debug assert: "fopAcM_ct No Call !!"
 #define fopAcM_ct(ptr, ClassName)                                                                  \
     if (!fopAcM_CheckCondition(ptr, fopAcCnd_INIT_e)) {                                            \
-        new (ptr) ClassName();                                                                     \
+        new (ptr) ClassName;                                                                       \
         fopAcM_OnCondition(ptr, fopAcCnd_INIT_e);                                                  \
     }
 
diff --git a/src/d/d_ky_thunder.cpp b/src/d/d_ky_thunder.cpp
index 5cbcb3b9..5840b23b 100644
--- a/src/d/d_ky_thunder.cpp
+++ b/src/d/d_ky_thunder.cpp
@@ -112,7 +112,7 @@ cPhs_State dThunder_c::create() {
     dScnKy_env_light_c& envLight = dKy_getEnvlight();
     camera_process_class *pCamera = (camera_process_class*)dComIfGp_getCamera(0);
 
-    new (this) dThunder_c();
+    new (this) dThunder_c; // tww-vita: no "()", GCC would zero the process header
     J3DModelData* modelData = (J3DModelData*)dComIfG_getObjectRes("Always", dRes_INDEX_ALWAYS_BDL_YTHDR00_e);
     JUT_ASSERT(DEMO_SELECT(111, 110), modelData != NULL);
 
diff --git a/src/d/d_s_name.cpp b/src/d/d_s_name.cpp
index 12e1b54a..432706de 100644
--- a/src/d/d_s_name.cpp
+++ b/src/d/d_s_name.cpp
@@ -1524,7 +1524,7 @@ static BOOL dScnName_Delete(dScnName_c* i_this) {
 
 /* 802323A8-802323F8       .text dScnName_Create__FP11scene_class */
 static cPhs_State dScnName_Create(scene_class* i_scn) {
-    dScnName_c* i_this = new (i_scn) dScnName_c();
+    dScnName_c* i_this = new (i_scn) dScnName_c; // tww-vita: no "()", GCC would zero the process header
     return i_this->create();
 }
 
