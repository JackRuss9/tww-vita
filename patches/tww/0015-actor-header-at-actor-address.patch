From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 20:31:20 +0100
Subject: [PATCH] Reason: keep each actor's process header at the actor's
 address

Under GCC (the Itanium C++ ABI) a class with virtual functions whose base
has none gets its vtable pointer at offset 0, with the base after it; MWCC
put the pointer at the end. 51 actor classes (Link, NPCs, items, moving
platforms...) add virtual functions to fopAc_ac_c, so their fopAc_ac_c
part, and the process header the framework reads through void* and casts,
sat 4 bytes after the object (Link's creation crashed in fpcPi_Change).

On PC, base_process_class carries the vtable slot (one empty virtual
function), and leafdraw_class and fopAc_ac_c inherit their headers rather
than holding them as a first member, so every actor's vtable pointer
shares that slot and the header stays at the actor's address. Processes
without virtual functions leave the slot null. The few places that named
the old members (base.base.mBsPcId, i_leaf->base.*) use the inherited
fields.
---
 include/f_op/f_op_actor.h       | 10 ++++++++++
 include/f_pc/f_pc_base.h        |  8 ++++++++
 include/f_pc/f_pc_leaf.h        |  5 +++++
 src/d/actor/d_a_obj_hlift.cpp   |  6 +++---
 src/d/actor/d_a_obj_ladder.cpp  |  2 +-
 src/d/actor/d_a_obj_movebox.cpp |  8 ++++----
 src/d/actor/d_a_stone.cpp       |  2 +-
 src/d/actor/d_a_stone2.cpp      |  2 +-
 src/d/actor/d_a_tsubo.cpp       |  2 +-
 src/f_pc/f_pc_leaf.cpp          |  8 ++++----
 10 files changed, 38 insertions(+), 15 deletions(-)

diff --git a/include/f_op/f_op_actor.h b/include/f_op/f_op_actor.h
index 6b651095..7ae3fb23 100644
--- a/include/f_op/f_op_actor.h
+++ b/include/f_op/f_op_actor.h
@@ -265,9 +265,15 @@ public:
     /* 0xC */ cXyz max;
 };
 
+#ifdef TARGET_PC
+// The process header is a base class here, not a member (see base_process_class).
+class fopAc_ac_c : public leafdraw_class {
+public:
+#else
 class fopAc_ac_c {
 public:
     /* 0x000 */ leafdraw_class base;
+#endif
     /* 0x0C0 */ int actor_type;
     /* 0x0C4 */ create_tag_class actor_tag;
     /* 0x0D8 */ create_tag_class draw_tag;
@@ -318,7 +324,9 @@ public:
     static void setStopStatus(u32 status) { stopStatus = status; }
 };  // Size: 0x290
 
+#ifndef TARGET_PC // (4 bytes larger: the vtable slot)
 STATIC_ASSERT(sizeof(fopAc_ac_c) == 0x290);
+#endif
 
 class fopEn_enemy_c : public fopAc_ac_c {
 public:
@@ -366,7 +374,9 @@ public:
     /* 0x2A9 */ u8 field_2A9[0x2AC - 0x2A9];
 };  // Size: 0x2AC
 
+#ifndef TARGET_PC
 STATIC_ASSERT(sizeof(fopEn_enemy_c) == 0x2AC);
+#endif
 
 BOOL fopAc_IsActor(void* actor);
 
diff --git a/include/f_pc/f_pc_base.h b/include/f_pc/f_pc_base.h
index 1f4a40af..9d2d2928 100644
--- a/include/f_pc/f_pc_base.h
+++ b/include/f_pc/f_pc_base.h
@@ -11,6 +11,14 @@
 typedef unsigned int fpc_ProcID;
 
 typedef struct base_process_class {
+#ifdef TARGET_PC
+    // tww-vita: actor classes with virtual functions get their vtable pointer
+    // at offset 0 under GCC (MWCC put it at the end), which shifted the
+    // actor's process header by 4 bytes. Every process starts with this
+    // slot instead (left null for processes without virtual functions), so
+    // the derived classes share it and keep the header at their address.
+    virtual void tww_vtable_slot() {}
+#endif
     /* 0x00 */ int mBsType;
     /* 0x04 */ fpc_ProcID mBsPcId;
     /* 0x08 */ s16 mProcName;
diff --git a/include/f_pc/f_pc_leaf.h b/include/f_pc/f_pc_leaf.h
index cb28c5b6..efe70b71 100644
--- a/include/f_pc/f_pc_leaf.h
+++ b/include/f_pc/f_pc_leaf.h
@@ -13,8 +13,13 @@ typedef struct leafdraw_method_class {
     /* 0x10 */ process_method_func mpDrawFunc;
 } leafdraw_method_class;
 
+#ifdef TARGET_PC
+// The header is a base class here, not a member (see base_process_class).
+typedef struct leafdraw_class : base_process_class {
+#else
 typedef struct leafdraw_class {
     /* 0x00 */ base_process_class base;
+#endif
     /* 0xB8 */ leafdraw_method_class* mpDrawMtd;
     /* 0xBC */ s8 mbUnk0;
     /* 0xBD */ u8 mbUnk1;
