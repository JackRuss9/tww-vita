@@ -24,8 +24,8 @@ J2DWindow::J2DWindow(J2DPane* param_0, JSURandomInputStream* param_1)
     s32 local_188 = param_1->getPosition();
     u32 header[2];
     param_1->read(header, 8);
-    mMagic = header[0];
-    s32 end = local_188 + header[1];
+    mMagic = J2D_BE32(header[0]);
+    s32 end = local_188 + J2D_BE32(header[1]);
     makePaneStream(param_0, param_1);
     JUTResReference stack_178;
     u8 r27 = param_1->readU8();
