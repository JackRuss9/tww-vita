+// BMG resources stay big-endian for JMessage's stream parser.
+#ifdef TARGET_PC
+#define MSG_BE16(value) port_be16(&(value))
+#define MSG_BE32(value) port_be32(&(value))
+#else
+#define MSG_BE16(value) (value)
+#define MSG_BE32(value) (value)
+#endif
+
+static JMSMesgEntry_c messageEntryNative(JMSMesgEntry_c entry) {
+    entry.mDataOffs = MSG_BE32(entry.mDataOffs);
+    entry.mMsgNo = MSG_BE16(entry.mMsgNo);
+    entry.mItemPrice = (s16)MSG_BE16(entry.mItemPrice);
+    entry.mNextMsgNo = MSG_BE16(entry.mNextMsgNo);
+    entry.field_0x0a = MSG_BE16(entry.field_0x0a);
+    return entry;
+}
