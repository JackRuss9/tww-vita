+    entry.mMsgNo = beLoad<u16>(&entry.mMsgNo);
+    entry.mItemPrice = beLoad<s16>(&entry.mItemPrice);
+    entry.mNextMsgNo = beLoad<u16>(&entry.mNextMsgNo);
+    entry.field_0x0a = beLoad<u16>(&entry.field_0x0a);
+    return entry;
+}
 
