+    // when a wall pushes the eye into him. This flag is cleared by Run each
+    // frame, and preparation clears the resulting player-draw status.
+    setFlag(0x10000000);
+    // Track Link through the same attention anchor as the other cameras.
+    // Keep the entering distance so merely touching C-stick does not zoom.
+    cXyz offset(mCamParam.Val(style, dCamStyleParam_UNK1),
+                mCamParam.Val(style, dCamStyleParam_CENTER_HEIGHT_BASE),
+                mCamParam.Val(style, dCamStyleParam_UNK0));
+    cXyz center = relationalPos(mpPlayerActor, &offset);
+    float blendXZ = limitf(mCamParam.Val(style, dCamStyleParam_UNK3), 0.0f, 1.0f);
+    float blendY = limitf(mCamParam.Val(style, dCamStyleParam_UNK4), 0.0f, 1.0f);
+    mViewCache.mCenter.x += (center.x - mViewCache.mCenter.x) * blendXZ;
+    mViewCache.mCenter.y += (center.y - mViewCache.mCenter.y) * blendY;
+    mViewCache.mCenter.z += (center.z - mViewCache.mCenter.z) * blendXZ;
+    mViewCache.mDirection.Val(state.radius, pitch, yaw);
+    mViewCache.mEye = mViewCache.mCenter + mViewCache.mDirection.Xyz();
