+bool dCamera_c::manualCamera(s32 style) {
+#ifdef TARGET_PC
+    // Functional PC orbit camera. The retail manual camera also couples
+    // vertical input to zoom/FOV and has special combat/vehicle branches;
+    // those are not reconstructed here. Mode selection, L recentering and
+    // the common terrain/wall collision pass remain in the original pipeline.
+    struct State {
+        f32 radius;
+        s16 pitch, yaw;
+    } state = {};
+    static_assert(sizeof(State) <= sizeof(mWork), "manual camera scratch");
+    if (!mpPlayerActor) return false;
+    if (m11C == 0) {
+        cSGlobe entering(mViewCache.mEye - mViewCache.mCenter);
+        state.radius = entering.R();
+        state.pitch = entering.V().Val();
+        state.yaw = entering.U().Val();
+        if (mStickMainValueLast > 0.05f) setDMCAngle();
+        m100 = m101 = m102 = 1;
+    } else {
+        memcpy(&state, &mWork, sizeof(state));
+    }
+    // Avoid analog drift, with continuous response outside the dead zone.
+    float x = mStickCPosXLast, y = mStickCPosYLast;
+    float magnitude = sqrtf(x * x + y * y);
+    if (magnitude > 0.15f) {
+        float response = limitf((magnitude - 0.15f) / 0.85f, 0.0f, 1.0f) / magnitude;
+        x *= response;
+        y *= response;
+    } else {
+        x = y = 0.0f;
+    }
+    cSAngle yaw(state.yaw), pitch(state.pitch);
+    yaw += cSAngle(x * mCamParam.Val(style, dCamStyleParam_LOCKON_LONGITUDE_MAX));
+    if (y != 0.0f) {
+        float degrees = pitch.Degree() + y * mCamParam.Val(style, dCamStyleParam_LOCKON_LATITUDE_MAX);
+        // Retail styles store these endpoints in either order (MM01
+        // uses 0/30; Grandma's MM18 uses 35/0).
+        float end1 = mCamParam.Val(style, dCamStyleParam_UNK16);
+        float end2 = mCamParam.Val(style, dCamStyleParam_UNK17);
+        degrees = limitf(degrees, end1 < end2 ? end1 : end2,
+                         end1 > end2 ? end1 : end2);
+        pitch.Val(degrees);
+    }
+    state.pitch = pitch.Val();
+    state.yaw = yaw.Val();
