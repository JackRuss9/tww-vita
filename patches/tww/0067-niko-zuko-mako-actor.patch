+    cXyz delta = rope->current.pos - current.pos;
+    mRopeLen = delta.abs();
+    mOmega = std::sqrtf(2.0f / mRopeLen);
+    f32 quarter = (M_PI / 2.0f) / mOmega;
+    mSwingAmp = 0x2EE0;
+
+    f32 s = cM_ssin(current.angle.y);
+    f32 c = cM_scos(current.angle.y);
