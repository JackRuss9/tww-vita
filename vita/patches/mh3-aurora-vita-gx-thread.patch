+#ifdef AURORA_GXM
+// tww-vita CMPR AS DXT1: GX's CMPR is DXT1 in 8x8 tiles of four 4x4 blocks,
+// with big-endian colours and the first texel in each row byte's top bits.
+// Reordered into GXM's swizzled UBC1 the GPU samples it compressed (an eighth
+// of RGBA8's memory traffic) and no RGBA8 expansion runs. One difference: a
+// transparent texel of a 3-colour block is black in DXT1, the 1:1 midpoint
+// in CMPR (edges of cut-out textures may darken slightly when filtered).
+static bool g_cmprBc1 = false;
+
+static std::vector<uint8_t> cmpr_level_to_bc1(const uint8_t* src, uint32_t w, uint32_t h) {
+  const uint32_t bw = std::max(w / 4, 1u), bh = std::max(h / 4, 1u);
+  std::vector<uint8_t> out(size_t(std::max(std::bit_ceil(w) / 4, 1u)) * std::max(std::bit_ceil(h) / 4, 1u) * 8);
+  const uint32_t tilesX = (w + 7) / 8, tilesY = (h + 7) / 8;
+
+  for (uint32_t ty = 0; ty < tilesY; ++ty)
+    for (uint32_t tx = 0; tx < tilesX; ++tx)
+      for (uint32_t sub = 0; sub < 4; ++sub, src += 8) {
+        const uint32_t bx = tx * 2 + (sub & 1), by = ty * 2 + (sub >> 1);
+        if (bx >= bw || by >= bh)
+          continue;
+        uint8_t* dst = out.data() + gfx::native_texture_morton(bx, by, std::max(std::bit_ceil(w) / 4, 1u), std::max(std::bit_ceil(h) / 4, 1u)) * 8;
+        dst[0] = src[1];
+        dst[1] = src[0];
+        dst[2] = src[3];
+        dst[3] = src[2];
+        for (int row = 0; row < 4; ++row) {
+          const uint8_t v = src[4 + row];
+          dst[4 + row] = uint8_t((v >> 6) | ((v >> 2) & 0x0c) | ((v << 2) & 0x30) | (v << 6));
+        }
+      }
+  return out;
+}
+
+static size_t cmpr_level_bytes(uint32_t w, uint32_t h) { return size_t((w + 7) / 8) * ((h + 7) / 8) * 32; }
+} // namespace
+
+extern "C" void aurora_vita_set_cmpr_bc1(int enabled) { aurora::gfx::g_cmprBc1 = enabled != 0; }
+
+namespace aurora::gfx {
+#endif
+
 TextureHandle new_static_texture_2d(uint32_t width, uint32_t height, uint32_t mips, u32 format, ArrayRef<uint8_t> data, bool tlut, const char* label) noexcept {
+#ifdef AURORA_GXM
+  if (g_cmprBc1 && format == GX_TF_CMPR && !tlut && width >= 4 && height >= 4 &&
+      ((std::has_single_bit(width) && std::has_single_bit(height)) || mips <= 1)) {
+    mips = clamp_mip_count(width, height, mips, label);
+    // Levels under 4x4 fall back to the RGBA8 path's last levels: stop there.
+    uint32_t levels = 0;
+    size_t need = 0;
+    while (levels < mips && std::max(width >> levels, 1u) >= 4 && std::max(height >> levels, 1u) >= 4) {
+      need += cmpr_level_bytes(width >> levels, height >> levels);
+      ++levels;
+    }
+    if (levels && need <= data.size()) {
+      auto handle = std::make_shared<TextureRef>(gl::create_texture(width, height, levels, gl::Format::BC1, label), Extent{width, height, 1},
+                                                 gl::Format::BC1, levels, format);
+      const uint8_t* src = data.data();
+      for (uint32_t mip = 0; mip < levels; ++mip) {
+        const uint32_t w = width >> mip, h = height >> mip;
+        gl::write_texture_packed(handle->texture, mip, cmpr_level_to_bc1(src, w, h));
+        src += cmpr_level_bytes(w, h);
+      }
+      return handle;
+    }
+  }
+#endif
 
   mips = clamp_mip_count(width, height, mips, label);
   auto handle = new_dynamic_texture_2d(width, height, mips, format, label);
