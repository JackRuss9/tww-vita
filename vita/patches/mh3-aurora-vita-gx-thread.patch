+void TextureStorage::upload_packed(uint32_t mip, const void* source, size_t bytes) {
+  const auto& level = m_levels.at(mip);
+  const size_t end = mip + 1 < m_levels.size() ? m_levels[mip + 1].offset : m_imageBytes;
+
+  if (!source || bytes > end - level.offset)
+    AURORA_THROW(std::runtime_error("Native packed upload exceeds its level"));
+  // Only fresh static textures take packed uploads: no GPU use to wait for.
+  std::memcpy(static_cast<char*>(m_data) + level.offset, source, bytes);
+}
