diff --git a/aurora-main/lib/gxm/tww_empty_shader_bank.cpp b/aurora-main/lib/gxm/tww_empty_shader_bank.cpp
new file mode 100644
index 0000000..386623b
--- /dev/null
+++ b/aurora-main/lib/gxm/tww_empty_shader_bank.cpp
@@ -0,0 +1,14 @@
+#include "shader_bank.hpp"
+
+// The first boot compiles GXM programs from source on demand. Keeping the
+// sentinel arrays nonempty also keeps the bank's pointer arithmetic valid.
+namespace aurora::gxm::shader_bank {
+const unsigned char* const Blob = nullptr;
+const uint32_t DictionaryBytes = 0;
+const Program VertexPrograms[1]{};
+const Program FragmentPrograms[1]{};
+const Program FragmentScalarPrograms[1]{};
+const size_t VertexProgramCount = 0;
+const size_t FragmentProgramCount = 0;
+const size_t FragmentScalarProgramCount = 0;
+}
