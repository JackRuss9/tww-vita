       target_compile_definitions(aurora_core PUBLIC AURORA_GXM)
-      target_compile_options(aurora_core PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-gline-tables-only>)
+      option(TWW_GXM_RUNTIME_SHADERS "Build the Vita renderer with runtime shaders for Wind Waker" OFF)
+      if(TWW_GXM_RUNTIME_SHADERS)
+        set(MH3_DEVELOPMENT ON)
+        set(TWW_VITASHARK_PREFIX "" CACHE PATH "Prefix containing VitaShaderRK and SceShaccCgExt")
+        if(TWW_VITASHARK_PREFIX)
+          target_include_directories(aurora_core PRIVATE "${TWW_VITASHARK_PREFIX}/include")
+          target_link_directories(aurora_core PUBLIC "${TWW_VITASHARK_PREFIX}/lib")
+        endif()
+        set(tww_gxm_utility "")
+        file(GLOB tww_gxm_sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/lib/gxm/utility/*.cg")
+        foreach(shader IN LISTS tww_gxm_sources)
+          get_filename_component(shader_name "${shader}" NAME_WE)
+          if(NOT shader_name MATCHES "^([0-9a-f]+)-([0-9a-f]+)_([vf])$")
+            message(FATAL_ERROR "Invalid GXM utility shader name: ${shader_name}")
+          endif()
+          if(CMAKE_MATCH_3 STREQUAL "v")
+            set(shader_key "${CMAKE_MATCH_1}")
+            set(shader_stage Vertex)
+          else()
+            set(shader_key "${CMAKE_MATCH_2}")
+            set(shader_stage Fragment)
+          endif()
+          file(READ "${shader}" shader_source)
+          set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${shader}")
+          string(APPEND tww_gxm_utility
+            "{0x${shader_key}ULL, RuntimeShaderStage::${shader_stage}, R\"tww(${shader_source})tww\"},\n")
+        endforeach()
+        file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/tww_gxm_utility.inc"
+          CONTENT "@tww_gxm_utility@" @ONLY)
+        target_include_directories(aurora_core PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
+        target_compile_definitions(aurora_core PRIVATE TWW_GXM_RUNTIME_SHADERS=1)
+        target_sources(aurora_core PRIVATE lib/gxm/tww_empty_shader_bank.cpp)
+      endif()
+      target_compile_options(aurora_core PRIVATE $<$<COMPILE_LANG_AND_ID:CXX,Clang>:-gline-tables-only>)
 
