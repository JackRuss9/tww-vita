new file mode 100644
--- /dev/null
+++ b/aurora-main/include/aurora/vita_host_alloc.hpp
@@ -0,0 +1,14 @@
+#pragma once
+
+extern "C" void tww_vita_begin_host_alloc();
+extern "C" void tww_vita_end_host_alloc();
+
+namespace aurora {
+class VitaHostAllocScope {
+public:
+  VitaHostAllocScope() { tww_vita_begin_host_alloc(); }
+  ~VitaHostAllocScope() { tww_vita_end_host_alloc(); }
+  VitaHostAllocScope(const VitaHostAllocScope&) = delete;
+  VitaHostAllocScope& operator=(const VitaHostAllocScope&) = delete;
+};
+} // namespace aurora
