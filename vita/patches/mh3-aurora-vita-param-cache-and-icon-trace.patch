+const SceGxmProgramParameter* PatchedProgram::find_parameter(const SceGxmProgram* binary, const char* name) {
+  for (const auto& entry : m_parameterCache)
+    if (entry.binary == binary && (entry.name == name || std::strcmp(entry.name, name) == 0))
+      return entry.parameter;
+
+  const auto* parameter = sceGxmProgramFindParameterByName(binary, name);
+  // Names come from the program description (stable storage) or literals.
+  m_parameterCache.push_back({binary, name, parameter});
+  return parameter;
+}
+
