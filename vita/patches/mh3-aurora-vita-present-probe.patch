+#ifdef TWW_GXM_RUNTIME_SHADERS
+namespace {
+Module PresentLog("aurora::gxm::present");
+std::atomic<bool> titleProbeRequested{false};
+
+void log_rgb(const char* label, const void* pixels, uint32_t width, uint32_t height, size_t stride) {
+  if (!pixels || !width || !height) {
+    PresentLog.info("{} unavailable", label);
+    return;
+  }
+  size_t nonblack = 0;
+  const auto* row = static_cast<const uint8_t*>(pixels);
+  for (uint32_t y = 0; y < height; ++y, row += stride) {
+    for (uint32_t x = 0; x < width; ++x) {
+      const auto* pixel = row + 4 * x;
+      nonblack += (pixel[0] | pixel[1] | pixel[2]) != 0;
+    }
+  }
+  const auto* center = static_cast<const uint8_t*>(pixels) + (height / 2) * stride + 4 * (width / 2);
+  PresentLog.info("{} {}x{} nonblack={}/{} center={:02x}{:02x}{:02x}",
+                  label, width, height, nonblack, size_t(width) * height,
+                  unsigned(center[0]), unsigned(center[1]), unsigned(center[2]));
+}
+
+void log_texture(const char* label, Renderer& r, const TexturePtr& texture) {
+  if (!texture) {
+    PresentLog.info("{} unavailable", label);
+    return;
+  }
+  const auto& storage = r.texture(texture->gl());
+  if (storage.format != Format::RGBA8) {
+    PresentLog.info("{} format={} (not RGBA8)", label, unsigned(storage.format));
+    return;
+  }
+  log_rgb(label, storage.pixels(), storage.width, storage.height, storage.row_bytes());
+}
+} // namespace
+
+extern "C" void aurora_vita_request_title_probe() {
+  titleProbeRequested.store(true, std::memory_order_release);
+}
