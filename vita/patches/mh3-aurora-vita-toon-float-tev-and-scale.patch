diff --git a/aurora-main/lib/gx/shader_info.cpp b/aurora-main/lib/gx/shader_info.cpp
index 4d75bef..c582fe0 100644
--- a/aurora-main/lib/gx/shader_info.cpp
+++ b/aurora-main/lib/gx/shader_info.cpp
@@ -398,6 +398,19 @@ ShaderInfo build_shader_info(const ShaderConfig& config) noexcept {
     }
   }
 
+  // GX_TG_SRTG reads R and G of a lit colour channel's output (Dolphin: vertex_lighting_N),
+  // so that channel must be computed even when no TEV stage rasterizes it. Wind Waker's
+  // toon shading (Link, Aryll, Grandma, NPCs) samples its ramp texture at that coordinate.
+  for (int i = 0; i < info.sampledTexCoords.size(); ++i) {
+    if (!info.sampledTexCoords.test(i)) {
+      continue;
+    }
+    const auto& tcg = config.tcgs[i];
+    if (tcg.type == GX_TG_SRTG && (tcg.src == GX_TG_COLOR0 || tcg.src == GX_TG_COLOR1)) {
+      info.sampledColorChannels.set(tcg.src - GX_TG_COLOR0);
+    }
+  }
+
   const auto loadsTevRegs = info.loadsTevRegRgb | info.loadsTevRegAlpha;
   info.uniformSize += loadsTevRegs.count() * sizeof(Vec4<float>);
 
