+static int s_vitaProfDepth;
+static unsigned long long s_vitaProfChild[32];
+static BOOL vita_prof_call(void* i_proc, int draw) {
+    base_process_class* proc = (base_process_class*)i_proc;
+    const int depth = s_vitaProfDepth;
+    if (!tww_vita_cpu_profile || depth >= 32)
+        return draw ? fpcDw_Execute(proc) : fpcEx_Execute(proc);
+    s_vitaProfChild[depth] = 0;
+    s_vitaProfDepth = depth + 1;
+    const unsigned long long start = tww_vita_prof_now();
+    const BOOL result = draw ? fpcDw_Execute(proc) : fpcEx_Execute(proc);
+    const unsigned long long total = tww_vita_prof_now() - start;
+    s_vitaProfDepth = depth;
+    if (depth > 0)
+        s_vitaProfChild[depth - 1] += total;
+    const unsigned long long child = s_vitaProfChild[depth];
+    tww_vita_prof_proc(proc->mProcName, draw, total > child ? total - child : 0);
+    return result;
+}
+#endif
