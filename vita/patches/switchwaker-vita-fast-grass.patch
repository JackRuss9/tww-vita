+namespace {
+// One tuft's display list as triangles: (position, colour, texcoord) indices.
+struct GrassTris {
+    const u8* source = NULL;
+    u32 size = 0;
+    bool ok = false;
+    int count = 0;
+    u8 idx[3 * 192];
+};
+GrassTris l_fastTris[2];
+
+void grass_add_vertex(GrassTris& t, const u8* v) {
+    if (t.count >= 192) { t.ok = false; return; }
+    t.idx[t.count * 3 + 0] = v[0];
+    t.idx[t.count * 3 + 1] = v[1];
+    t.idx[t.count * 3 + 2] = v[2];
+    t.count++;
+}
+
+// The tuft lists hold only draws of INDEX8 pos/clr/tex vertices (3 bytes each).
+const GrassTris& grass_parse(int slot, const u8* dl, u32 size) {
+    GrassTris& t = l_fastTris[slot];
+    if (t.source == dl && t.size == size)
+        return t;
+    t.source = dl; t.size = size; t.ok = true; t.count = 0;
+    u32 pos = 0;
+    while (pos < size && t.ok) {
+        const u8 cmd = dl[pos++];
+        if (cmd == 0)
+            continue;
+        if ((cmd & 0xC0) != 0x80 || (cmd & 7) != GX_VTXFMT0 || pos + 2 > size) { t.ok = false; break; }
+        const u32 n = (u32(dl[pos]) << 8) | dl[pos + 1];
+        pos += 2;
+        if (pos + n * 3 > size) { t.ok = false; break; }
+        const u8* v = dl + pos;
+        switch (cmd & 0xF8) {
+        case GX_TRIANGLES:
+            for (u32 i = 0; i + 2 < n; i += 3)
+                for (u32 k = 0; k < 3; k++) grass_add_vertex(t, v + (i + k) * 3);
+            break;
+        case GX_TRIANGLESTRIP:
+            for (u32 i = 0; i + 2 < n; i++) {
+                const u32 a = i, b = (i & 1) ? i + 2 : i + 1, c = (i & 1) ? i + 1 : i + 2;
+                grass_add_vertex(t, v + a * 3); grass_add_vertex(t, v + b * 3); grass_add_vertex(t, v + c * 3);
+            }
+            break;
+        case GX_TRIANGLEFAN:
+            for (u32 i = 1; i + 1 < n; i++) {
+                grass_add_vertex(t, v); grass_add_vertex(t, v + i * 3); grass_add_vertex(t, v + (i + 1) * 3);
+            }
+            break;
+        case GX_QUADS:
+            for (u32 i = 0; i + 3 < n; i += 4) {
+                const u32 q[6] = {i, i + 1, i + 2, i, i + 2, i + 3};
+                for (u32 k = 0; k < 6; k++) grass_add_vertex(t, v + q[k] * 3);
+            }
+            break;
+        default:
+            t.ok = false;
+            break;
+        }
+        pos += n * 3;
+    }
+    if (t.count == 0)
+        t.ok = false;
+    return t;
+}
+
+inline void put_be32(u8*& o, f32 f) {
+    u32 v;
+    memcpy(&v, &f, 4);
+    o[0] = u8(v >> 24); o[1] = u8(v >> 16); o[2] = u8(v >> 8); o[3] = u8(v);
+    o += 4;
+}
+
+// A display list of up to kMaxVerts GX_TRIANGLES vertices (pos F32 direct, clr/tex INDEX8).
+const int kMaxVerts = 3000;
+u8 l_fastDL[3 + kMaxVerts * 14 + 32] ATTRIBUTE_ALIGN(32);
+}
+
+static bool tww_vita_draw_grass_fast(dGrass_packet_c* pkt, bool vmori);
+#endif
