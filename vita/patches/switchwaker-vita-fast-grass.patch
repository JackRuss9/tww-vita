+namespace {
+// One tuft's display list as triangles: (position, colour, texcoord) indices.
+struct GrassTris {
+    const u8* source = NULL;
+    u32 size = 0;
+    bool ok = false;
+    int count = 0;       // vertices, all primitives together
+    int prims = 0;
+    u8 primType[16];     // GX primitive (GX_TRIANGLESTRIP...), as in the tuft list
+    u8 primCount[16];    // its vertex count
+    u8 idx[3 * 192];     // pos/clr/tex indices of every vertex, in order
+};
+GrassTris l_fastTris[2];
+
+// The tuft lists hold only draws of INDEX8 pos/clr/tex vertices (3 bytes each). Each draw
+// is kept as it is (01.86: strips are no longer expanded into triangle lists, so a tuft
+// sends about half the vertices).
+const GrassTris& grass_parse(int slot, const u8* dl, u32 size) {
+    GrassTris& t = l_fastTris[slot];
+    if (t.source == dl && t.size == size)
+        return t;
+    t.source = dl; t.size = size; t.ok = true; t.count = 0; t.prims = 0;
+    u32 pos = 0;
+    while (pos < size && t.ok) {
+        const u8 cmd = dl[pos++];
+        if (cmd == 0)
+            continue;
+        if ((cmd & 0xC0) != 0x80 || (cmd & 7) != GX_VTXFMT0 || pos + 2 > size) { t.ok = false; break; }
+        const u32 n = (u32(dl[pos]) << 8) | dl[pos + 1];
+        pos += 2;
+        if (pos + n * 3 > size) { t.ok = false; break; }
+        const u8 type = cmd & 0xF8;
+        if (type != GX_TRIANGLES && type != GX_TRIANGLESTRIP && type != GX_TRIANGLEFAN && type != GX_QUADS) {
+            t.ok = false;
+            break;
+        }
+        if (n == 0) continue;
+        if (t.prims >= 16 || n > 255 || t.count + int(n) > 192) { t.ok = false; break; }
+        t.primType[t.prims] = type;
+        t.primCount[t.prims] = u8(n);
+        t.prims++;
+        memcpy(t.idx + t.count * 3, dl + pos, n * 3);
+        t.count += n;
+        pos += n * 3;
+    }
+    if (t.count == 0)
+        t.ok = false;
+    return t;
+}
+
+inline void put_be32(u8*& o, f32 f) {
+    u32 v;
+    memcpy(&v, &f, 4);
+    o[0] = u8(v >> 24); o[1] = u8(v >> 16); o[2] = u8(v >> 8); o[3] = u8(v);
+    o += 4;
+}
+
+// A display list of up to kMaxVerts vertices (pos F32 direct, clr/tex INDEX8), the tufts'
+// own primitives one after another.
+const int kMaxVerts = 3000;
+u8 l_fastDL[3 + kMaxVerts * 14 + 32] ATTRIBUTE_ALIGN(32);
+}
