+#if defined(__vita__)
+static bool tww_vita_draw_grass_fast(dGrass_packet_c* pkt, bool vmori) {
+    const GrassTris& full = grass_parse(0, (const u8*)pkt->mpDL, pkt->mDLSize);
+    const GrassTris& cut = grass_parse(1, (const u8*)pkt->mpDLCut, pkt->mDLCutSize);
+    if (!full.ok || !cut.ok)
+        return false;
+
+    static GXVtxDescList l_fastDesc[] = {
+        {GX_VA_POS, GX_DIRECT},
+        {GX_VA_CLR0, GX_INDEX8},
+        {GX_VA_TEX0, GX_INDEX8},
+        {GX_VA_NULL, GX_NONE},
+    };
+    GFSetVtxDescv(l_fastDesc);
+    Mtx identity;
+    MTXIdentity(identity);
+    GXLoadPosMtxImm(identity, GX_PNMTX0);
+
+    const cXyz* positions = (const cXyz*)pkt->mpPosArr;
+    const u32 posCount = (vmori ? sizeof(l_Vmori_pos) : sizeof(l_pos)) / sizeof(cXyz);
+    dGrass_room_c* room = &pkt->mGrassRoom[0];
+    for (s32 i = 0; i < (s32)ARRAY_SIZE(pkt->mGrassRoom); room++, i++) {
+        if (room->mpData == NULL)
+            continue;
+        bool any = false;
+        for (dGrass_data_c* data = room->mpData; data != NULL; data = data->mpNextData)
+            if (!cLib_checkBit<u8>(data->mInitFlags, 0x02)) { any = true; break; }
+        if (!any)
+            continue;
+        dKy_tevstr_c* tevstr = dComIfGp_roomControl_getTevStr(i);
+        GFSetTevColorS10(GX_TEVREG0, tevstr->mColorC0);
+        GFSetTevColor(GX_TEVREG1, tevstr->mColorK0);
+        dKy_GfFog_tevstr_set(tevstr);
+
+        int verts = 0;
+        u8* out = l_fastDL + 3;
+        const auto flush = [&]() {
+            if (verts == 0)
+                return;
+            l_fastDL[0] = u8(GX_TRIANGLES | GX_VTXFMT0);
+            l_fastDL[1] = u8(verts >> 8);
+            l_fastDL[2] = u8(verts);
+            u32 bytes = u32(out - l_fastDL);
+            while (bytes & 31)
+                l_fastDL[bytes++] = 0;
+            GXCallDisplayList(l_fastDL, bytes);
+            verts = 0;
+            out = l_fastDL + 3;
+        };
+        for (dGrass_data_c* data = room->mpData; data != NULL; data = data->mpNextData) {
+            if (cLib_checkBit<u8>(data->mInitFlags, 0x02))
+                continue;
+            const GrassTris& t = data->mAnimIdx >= 0 ? full : cut;
+            if (verts + t.count > kMaxVerts)
+                flush();
+            const MtxP m = data->mModelMtx;
+            for (int v = 0; v < t.count; v++) {
+                const u8* ix = t.idx + v * 3;
+                const u32 pi = ix[0] < posCount ? ix[0] : 0;
+                const f32 x = positions[pi].x, y = positions[pi].y, z = positions[pi].z;
+                put_be32(out, m[0][0] * x + m[0][1] * y + m[0][2] * z + m[0][3]);
+                put_be32(out, m[1][0] * x + m[1][1] * y + m[1][2] * z + m[1][3]);
+                put_be32(out, m[2][0] * x + m[2][1] * y + m[2][2] * z + m[2][3]);
+                *out++ = ix[1];
+                *out++ = ix[2];
+            }
+            verts += t.count;
+        }
+        flush();
+    }
+    return true;
+}
+#endif
