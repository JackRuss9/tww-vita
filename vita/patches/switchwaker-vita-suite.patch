+bool mDoMch_CreateGameHeaps(u32 commandBytes, u32 archiveBytes, u32 gameBytes, JKRHeap* sysHeap) {
+    JKRHeap* root = JKRHeap::getRootHeap();
+    if (!mDoExt_createCommandHeap(commandBytes, root) ||
+        !mDoExt_createArchiveHeap(archiveBytes, root) ||
+        !mDoExt_createGameHeap(gameBytes, root)) {
+        return false;
+    }
+    const s32 zeldaBytes = sysHeap->getFreeSize() - 0x10000;
+    if (zeldaBytes <= 0) {
+        return false;
+    }
+    JKRHeap* zelda = mDoExt_createZeldaHeap(zeldaBytes, sysHeap);
+    if (!zelda) {
+        return false;
+    }
+    JKRSetCurrentHeap(zelda);
+    return true;
+}
+#endif
